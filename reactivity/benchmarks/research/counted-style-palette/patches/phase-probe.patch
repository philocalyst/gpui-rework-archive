+// Kept as a shared source patch in the paired f019/counted worktrees. This is
+// an opt-in diagnostic, not part of the ordinary test or build path.
+#[inline(never)]
+fn palette_read_probe(styles: &styles::Styles, count: usize, rounds: usize) -> u64 {
+    let mut checksum = 0u64;
+    for _ in 0..rounds {
+        for index in 0..count {
+            let style = styles.get(index);
+            checksum = checksum
+                .wrapping_add(u64::from(style.gap.to_bits()))
+                .wrapping_add(u64::from(style.font_size.to_bits()));
+        }
+    }
+    std::hint::black_box(checksum)
+}
+
+#[inline(never)]
+fn palette_set_probe(styles: &mut styles::Styles, index: usize, style: Style, count: usize) {
+    styles.set(index, style, count);
+}
+
+fn palette_storage(styles: &styles::Styles) -> (usize, usize, usize) {
+    match styles {
+        styles::Styles::Default => (0, 0, 0),
+        styles::Styles::Dense(values) => (1, values.capacity() * size_of::<Style>(), 0),
+        styles::Styles::Shared { palette, indices } => (
+            2,
+            size_of_val(palette.as_ref()) + size_of_val(indices.as_ref()),
+            palette.first().map_or(0, |entry| size_of_val(entry)),
+        ),
+    }
+}
+
+fn palette_snapshot<M: View + 'static>(win: &Win<M>) -> Vec<Style> {
+    let runtime = win.runtime().unwrap();
+    (0..runtime.nodes.len())
+        .map(|index| *runtime.styles.get(index))
+        .collect()
+}
+
+fn palette_seed(source: &[Style]) -> Vec<Style> {
+    let colors = [
+        0x112233, 0x234567, 0x345678, 0x456789, 0x56789a, 0x6789ab, 0x789abc, 0x89abcd,
+    ];
+    let mut seed = Vec::new();
+    for style in source {
+        if seed.iter().all(|old| !styles::exact_eq(old, style)) {
+            let mut value = *style;
+            value.bg = rgb(colors[seed.len() % colors.len()]);
+            seed.push(value);
+            if seed.len() == colors.len() {
+                break;
+            }
+        }
+    }
+    if seed.is_empty() {
+        seed.push(Style::default());
+    }
+    seed
+}
+
+fn profile_lane(label: &str, seed: &[Style], count: usize) {
+    let mut lane = None;
+    let allocation = allocation_counter::measure(|| {
+        let mut builder = styles::Builder::new(count);
+        for index in 0..count {
+            builder.push(&seed[index % seed.len()]);
+        }
+        lane = Some(builder.finish());
+    });
+    let lane = lane.unwrap();
+    let (mode, bytes, entry_bytes) = palette_storage(&lane);
+    println!(
+        "phase,build,{label},{count},{mode},{bytes},{entry_bytes},1,0,{},{},{},",
+        allocation.count_total, allocation.bytes_total, allocation.bytes_max
+    );
+
+    let reads = 16usize;
+    let start = std::time::Instant::now();
+    let checksum = palette_read_probe(&lane, count, reads);
+    let (mode, bytes, entry_bytes) = palette_storage(&lane);
+    println!(
+        "phase,warm_read,{label},{count},{mode},{bytes},{entry_bytes},{reads},{},0,0,0,{checksum}",
+        start.elapsed().as_nanos(),
+    );
+
+    let mut sparse = lane;
+    let mut changed = seed[0];
+    changed.bg = rgb(0xd15ea5);
+    let start = std::time::Instant::now();
+    let allocation = allocation_counter::measure(|| {
+        palette_set_probe(&mut sparse, 0, changed, count);
+    });
+    let elapsed = start.elapsed().as_nanos();
+    let (mode, bytes, entry_bytes) = palette_storage(&sparse);
+    println!(
+        "phase,first_sparse_set,{label},{count},{mode},{bytes},{entry_bytes},1,{elapsed},{},{},{},",
+        allocation.count_total, allocation.bytes_total, allocation.bytes_max
+    );
+
+    let mut cohort = styles::Builder::new(count);
+    for index in 0..count {
+        cohort.push(&seed[index % seed.len()]);
+    }
+    let mut cohort = cohort.finish();
+    let frames = 4usize;
+    let start = std::time::Instant::now();
+    let allocation = allocation_counter::measure(|| {
+        for frame in 1..=frames {
+            for index in 0..count {
+                let mut value = seed[index % seed.len()];
+                value.bg = rgb(0xa00000 + ((frame * 17 + index % seed.len()) as u32));
+                cohort.set(index, value, count);
+            }
+        }
+    });
+    let elapsed = start.elapsed().as_nanos();
+    let (mode, bytes, entry_bytes) = palette_storage(&cohort);
+    println!(
+        "phase,cohort_mutations,{label},{count},{mode},{bytes},{entry_bytes},{frames},{elapsed},{},{},{},",
+        allocation.count_total, allocation.bytes_total, allocation.bytes_max
+    );
+}
