+//! Stage-specific changed-group resolution using REAL canonical Canvas groups.
+//! Private adapter until producer SceneGroups/closure interface lands. This does
+//! not clear v0 FullReasons or claim that a list of dirty sites proves closure.
+use super::*;
+use gpui_canvas::{PreparedGroup, PreparedScene};
+use gpui_reactivity_core::change::SiteId;
+use std::{collections::{BTreeMap,HashSet}, ops::Range};
+
+#[derive(Clone)]
+struct Span { site: SiteId, draws: Range<usize> }
+// Immutable accepted snapshot adapter. Replace storage with canonical owner's
+// SceneGroups, not a second production group/rank catalog.
+struct Ranges {
+    revision: SceneRevision, source_epoch: u64, snapshot_epoch: u64,
+    draws:usize, ordered: Vec<Span>, by_site: BTreeMap<SiteId,usize>,
+}
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+enum ResolveFallback { Header, Metadata, HardFull(FullReasons), TrulyUnbounded, Allocation }
+impl Ranges {
+    fn checked(revision:SceneRevision,source_epoch:u64,snapshot_epoch:u64,ordered:Vec<Span>,draws:usize)->Result<Self,ResolveFallback> {
+        if snapshot_epoch==0 {return Err(ResolveFallback::Header);}
+        let mut cursor=0;let mut by_site=BTreeMap::new();
+        for (index,span) in ordered.iter().enumerate() {
+            if span.site.owner!=revision.owner || span.draws.start!=cursor || span.draws.end<span.draws.start
+                || span.draws.end>draws || by_site.insert(span.site,index).is_some() {return Err(ResolveFallback::Metadata);}
+            cursor=span.draws.end;
+        }
+        if cursor!=draws {return Err(ResolveFallback::Metadata);}
+        Ok(Self {revision,source_epoch,snapshot_epoch,draws,ordered,by_site})
+    }
+}
+// Captured from the backend's admitted OLD complete-group allocations, never
+// inferred from new scene offsets. Build/validate once during initial admission.
+struct StoredGroups { revision:SceneRevision, groups:Vec<Range<usize>>, draws:usize }
+impl StoredGroups {
+    fn checked(revision:SceneRevision,groups:Vec<Range<usize>>,draws:usize)->Result<Self,ResolveFallback> {
+        let mut cursor=0;
+        for group in &groups {
+            if group.start!=cursor || group.end<=group.start || group.end>draws {return Err(ResolveFallback::Metadata);}
+            cursor=group.end;
+        }
+        if cursor!=draws {return Err(ResolveFallback::Metadata);}
+        Ok(Self {revision,groups,draws})
+    }
+    fn covering(&self,draw:usize)->Option<&Range<usize>> {
+        let index=self.groups.partition_point(|group|group.end<=draw);
+        self.groups.get(index).filter(|group|group.start<=draw && draw<group.end)
+    }
+}
+// This is a typed producer/closure boundary, not user-supplied dirty rectangles.
+// The actual producer must issue it ONLY after old/new ancestor, sibling-layout,
+// clip, stacking, resource and nonlocal/readback/filter closure is complete.
+struct ClosedSites<'a>(&'a [SiteId]);
+enum PendingSupport { LogicalUnresolved, AlreadyResolved, TrulyUnbounded }
+struct Pending<'a> {
+    batch: &'a ChangeBatch,
+    old: &'a Ranges, new: &'a Ranges, old_groups:&'a StoredGroups,
+    scene: PreparedScene<'a>,
+    closed: ClosedSites<'a>,
+    // Source adapter separates unresolved logical bounds from genuine hard full
+    // reasons. NEVER derive this by removing UNKNOWN_SUPPORT from a v0 batch.
+    hard: FullReasons, support: PendingSupport,
+}
+struct SelectedGroup<'a> {
+    group: PreparedGroup<'a>, draws: Range<usize>,
+    // Ordered overlap WINDOW into paired metadata; empty own ranges inside it
+    // are not contributors. Includes unchanged real owners of this full group.
+    owners: Range<usize>,
+}
+#[derive(Default,Debug)]
+struct ResolveWork { sites:usize, range_reads:usize, old_group_queries:usize, new_group_queries:usize, owner_edges:usize, old_groups:usize, canonical_groups:usize, placements:usize }
+struct Resolved<'a> {
+    old_metadata:&'a Ranges, new_metadata:&'a Ranges,
+    new_groups:Vec<SelectedGroup<'a>>,
+    // Old scene-local spans locate OLD stored supports/handles; never reused as
+    // identities or as offsets into the NEW snapshot.
+    old_ranges:Vec<Range<usize>>,
+    work:ResolveWork,
+}
+fn vec_reserve<T>(value:&mut Vec<T>,additional:usize)->Result<(),ResolveFallback> {
+    value.try_reserve(additional).map_err(|_|ResolveFallback::Allocation)
+}
+fn enqueue(site:SiteId,pending:&mut Vec<SiteId>,seen:&mut HashSet<SiteId>)->Result<(),ResolveFallback> {
+    if seen.contains(&site) {return Ok(());}
+    seen.try_reserve(1).map_err(|_|ResolveFallback::Allocation)?;
+    vec_reserve(pending,1)?;seen.insert(site);pending.push(site);Ok(())
+}
+fn owners(ranges:&Ranges,whole:&Range<usize>)->Range<usize> {
+    let first=ranges.ordered.partition_point(|s|s.draws.end<=whole.start);
+    let end=ranges.ordered.partition_point(|s|s.draws.start<whole.end);
+    first..end
+}
+// Read-only lazy adjacency for the SHARED core dependency frontier. This owns
+// no visited set/queue and grants no accepted-scene or output authority. The
+// provisional range adapter will be replaced by producer view/backend receipts.
+struct MembershipEdges<'a> {
+    old:&'a Ranges, old_groups:&'a StoredGroups,
+    new:&'a Ranges, scene:PreparedScene<'a>,
+}
+impl MembershipEdges<'_> {
+    fn site_groups(&self,site:SiteId,mut emit:impl FnMut(SceneRevision,usize)->Result<(),ResolveFallback>)->Result<usize,ResolveFallback> {
+        if site.owner!=self.old.revision.owner || site.owner!=self.new.revision.owner {return Err(ResolveFallback::Header);}
+        let mut queries=0;
+        if let Some(index)=self.old.by_site.get(&site) {
+            let span=&self.old.ordered[*index];let mut draw=span.draws.start;
+            while draw<span.draws.end {
+                let group=self.old_groups.covering(draw).ok_or(ResolveFallback::Metadata)?;
+                queries+=1;emit(self.old.revision,group.start)?;draw=group.end.min(span.draws.end);
+            }
+        }
+        if let Some(index)=self.new.by_site.get(&site) {
+            let span=&self.new.ordered[*index];let mut draw=span.draws.start;
+            while draw<span.draws.end {
+                let (_,group)=self.scene.group_covering_draw(draw).ok_or(ResolveFallback::Metadata)?;
+                queries+=1;emit(self.new.revision,group.start)?;draw=group.end.min(span.draws.end);
+            }
+        }
+        Ok(queries)
+    }
+    fn group_owners(&self,snapshot:SceneRevision,first:usize,mut emit:impl FnMut(SiteId)->Result<(),ResolveFallback>)->Result<usize,ResolveFallback> {
+        let (ranges,whole)=if snapshot==self.old.revision {
+            let whole=self.old_groups.covering(first).ok_or(ResolveFallback::Metadata)?;
+            if whole.start!=first {return Err(ResolveFallback::Metadata);}
+            (self.old,whole.clone())
+        }else if snapshot==self.new.revision {
+            let (_,whole)=self.scene.group_covering_draw(first).ok_or(ResolveFallback::Metadata)?;
+            if whole.start!=first {return Err(ResolveFallback::Metadata);}
+            (self.new,whole)
+        }else{return Err(ResolveFallback::Header)};
+        let mut edges=0;
+        for owner in owners(ranges,&whole) {
+            let span=&ranges.ordered[owner];if span.draws.is_empty() {continue;}
+            edges+=1;emit(span.site)?;
+        }
+        Ok(edges)
+    }
+}
+impl<'a> Pending<'a> {
+    fn resolve(self)->Result<Resolved<'a>,ResolveFallback> {
+        // Until the producer exports the stage-specific Pending/HardFull split,
+        // every v0 full reason remains binding. Independent hard input may only
+        // ADD reasons, never erase a raw revision/history/capacity failure.
+        let hard=self.hard.union(self.batch.full);
+        if !hard.is_empty() {return Err(ResolveFallback::HardFull(hard));}
+        if matches!(self.support,PendingSupport::TrulyUnbounded) {return Err(ResolveFallback::TrulyUnbounded);}
+        if self.old.revision.owner!=self.new.revision.owner || self.new.revision.sequence<=self.old.revision.sequence
+            || self.batch.stamp.from!=Some(self.old.revision) || self.batch.stamp.to!=self.new.revision
+            || self.batch.stamp.source_epoch!=self.new.source_epoch
+            || self.batch.stamp.snapshot_epoch!=self.new.snapshot_epoch
+            || self.old_groups.revision!=self.old.revision || self.old_groups.draws!=self.old.draws
+            || self.scene.draws().len()!=self.new.draws {return Err(ResolveFallback::Header);}
+        let mut pending=Vec::new();let mut seen=HashSet::new();
+        for site in self.closed.0 {enqueue(*site,&mut pending,&mut seen)?;}
+        let mut old_seen=HashSet::new();let mut new_seen=HashSet::new();
+        let mut old_ranges=Vec::new();let mut groups=Vec::new();let mut work=ResolveWork::default();
+        while let Some(site)=pending.pop() {
+            if site.owner!=self.new.revision.owner {return Err(ResolveFallback::Metadata);}
+            work.sites+=1;
+            if let Some(index)=self.old.by_site.get(&site) {
+                let span=&self.old.ordered[*index];work.range_reads+=1;let mut draw=span.draws.start;
+                while draw<span.draws.end {
+                    work.old_group_queries+=1;
+                    let whole=self.old_groups.covering(draw).ok_or(ResolveFallback::Metadata)?;
+                    if !old_seen.contains(&whole.start) {
+                        old_seen.try_reserve(1).map_err(|_|ResolveFallback::Allocation)?;old_seen.insert(whole.start);
+                        vec_reserve(&mut old_ranges,1)?;old_ranges.push(whole.clone());work.old_groups+=1;
+                        for owner in owners(self.old,whole) {
+                            if self.old.ordered[owner].draws.is_empty() {continue;}
+                            work.owner_edges+=1;
+                            enqueue(self.old.ordered[owner].site,&mut pending,&mut seen)?;
+                        }
+                    }
+                    draw=whole.end.min(span.draws.end);
+                }
+            }
+            if let Some(index)=self.new.by_site.get(&site) {
+                let span=&self.new.ordered[*index];work.range_reads+=1;let mut draw=span.draws.start;
+                while draw<span.draws.end {
+                    work.new_group_queries+=1;
+                    let (group,whole)=self.scene.group_covering_draw(draw).ok_or(ResolveFallback::Metadata)?;
+                    if !new_seen.contains(&whole.start) {
+                        new_seen.try_reserve(1).map_err(|_|ResolveFallback::Allocation)?;new_seen.insert(whole.start);
+                        let owner_range=owners(self.new,&whole);
+                        if owner_range.is_empty() {return Err(ResolveFallback::Metadata);}
+                        for owner in owner_range.clone() {
+                            if self.new.ordered[owner].draws.is_empty() {continue;}
+                            work.owner_edges+=1;
+                            enqueue(self.new.ordered[owner].site,&mut pending,&mut seen)?;
+                        }
+                        vec_reserve(&mut groups,1)?;
+                        work.canonical_groups+=1;work.placements+=group.placements().len();
+                        groups.push(SelectedGroup {group,draws:whole.clone(),owners:owner_range});
+                    }
+                    draw=whole.end.min(span.draws.end);
+                }
+            }
+            // A nonpainting removed ancestor may be absent from both snapshots;
+            // the producer's CLOSED dependency set must contain its consumers.
+        }
+        old_ranges.sort_unstable_by_key(|range|range.start);
+        groups.sort_unstable_by_key(|group|group.draws.start);
+        Ok(Resolved {old_metadata:self.old,new_metadata:self.new,new_groups:groups,old_ranges,work})
+    }
+}
+
