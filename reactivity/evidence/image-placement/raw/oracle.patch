+use gpui::{prelude::*, *};
+
+fn pixels() -> Image {
+    Image::rgba8(
+        2,
+        2,
+        ImageProfile::Srgb,
+        AlphaMode::Straight,
+        vec![
+            255, 0, 0, 255, 0, 255, 0, 127, 0, 0, 255, 63, 20, 90, 180, 255,
+        ]
+        .into_boxed_slice(),
+    )
+    .unwrap()
+}
+struct Positioned {
+    cover: Image,
+    horizontal: bool,
+    clipped: bool,
+    scale: f32,
+    sampling: ImageSampling,
+}
+impl View for Positioned {
+    fn view(&self) -> El<'_> {
+        let cover = image(&self.cover).size(16).p(2).sampling(self.sampling);
+        let children = (div().w(20).h(20), cover);
+        let root = if self.horizontal {
+            row(children)
+        } else {
+            column(children)
+        };
+        root.size(80)
+            .p(4)
+            .gap(3)
+            .rounded(if self.clipped { 8. } else { 0. })
+            .clipped(self.clipped)
+            .transform(Affine {
+                a: self.scale,
+                d: self.scale,
+                tx: 3.,
+                ty: 2.,
+                ..Affine::IDENTITY
+            })
+    }
+}
+fn compare<M: View + 'static>(win: &mut Win<M>, expected: &mut gpui_canvas::Canvas) {
+    let expected = expected.pixels();
+    win.with_pixels(|actual, _, _| {
+        assert_eq!(actual.len(), expected.len());
+        let difference = actual
+            .iter()
+            .zip(expected)
+            .enumerate()
+            .find(|(_, (a, b))| a != b)
+            .map(|(i, (a, b))| (i, *a, *b));
+        assert_eq!(
+            difference, None,
+            "first differing byte (index, actual, expected)"
+        );
+    })
+    .unwrap();
+}
+
+#[test]
+fn positioned_padded_images_match_independent_canvas_under_parent_clips() {
+    for horizontal in [false, true] {
+        for clipped in [false, true] {
+            for scale in [1., 1.25] {
+                for sampling in [ImageSampling::Nearest, ImageSampling::Linear] {
+                    let cover = pixels();
+                    let mut expected = gpui_canvas::Canvas::new(128, 128).unwrap();
+                    expected.clear(Color::WHITE);
+                    let root_map = Affine {
+                        a: scale,
+                        d: scale,
+                        tx: 3.,
+                        ty: 2.,
+                        ..Affine::IDENTITY
+                    };
+                    let clip = if clipped {
+                        expected
+                            .create_clip(
+                                None,
+                                gpui_canvas::ClipShape::RoundedRect {
+                                    rect: Rect::new(0., 0., 80., 80.),
+                                    radius: 8.,
+                                },
+                                root_map,
+                            )
+                            .unwrap()
+                            .into()
+                    } else {
+                        gpui_canvas::Clip::Rect(Rect::new(0., 0., 128., 128.))
+                    };
+                    // Parent padding 4 + preceding sibling 20 + gap 3. The
+                    // image's own padding is local; its position enters once.
+                    let (x, y) = if horizontal { (27., 4.) } else { (4., 27.) };
+                    expected
+                        .draw_image(
+                            &cover,
+                            Rect::new(2., 2., 12., 12.),
+                            Affine {
+                                tx: 3. + x * scale,
+                                ty: 2. + y * scale,
+                                ..root_map
+                            },
+                            clip,
+                            sampling,
+                        )
+                        .unwrap();
+                    let mut win = Win::with_size(
+                        Positioned {
+                            cover,
+                            horizontal,
+                            clipped,
+                            scale,
+                            sampling,
+                        },
+                        128,
+                        128,
+                    )
+                    .unwrap();
+                    eprintln!(
+                        "IMAGE_CASE horizontal={horizontal} clipped={clipped} scale={scale} sampling={sampling:?}"
+                    );
+                    compare(&mut win, &mut expected);
+                    assert_eq!(win.with_scene(|s, _| s.images().count()).unwrap(), 1);
+                    let target = win.role(Role::Image).one().unwrap();
+                    let center = Point {
+                        x: 3. + (x + 8.) * scale,
+                        y: 2. + (y + 8.) * scale,
+                    };
+                    let mut contained = false;
+                    win.visit(|part| {
+                        if part.target() == target {
+                            contained = part.contains_point(center);
+                        }
+                    })
+                    .unwrap();
+                    assert!(contained);
+                }
+            }
+        }
+    }
+}
+
+struct Scrolled(Image);
+impl View for Scrolled {
+    fn view(&self) -> El<'_> {
+        column((div().w(16).h(30), image(&self.0).size(16).p(2)))
+            .w(24)
+            .h(20)
+            .scroll(Axis::Y)
+            .transform(Affine::translation(3., 2.))
+    }
+}
+#[test]
+fn a_scrolled_image_enters_the_visible_clip_at_its_single_placement() {
+    let cover = pixels();
+    let mut expected = gpui_canvas::Canvas::new(64, 64).unwrap();
+    expected.clear(Color::WHITE);
+    expected
+        .draw_image(
+            &cover,
+            Rect::new(2., 2., 12., 12.),
+            Affine::translation(3., 16.),
+            Rect::new(3., 2., 24., 20.),
+            ImageSampling::Linear,
+        )
+        .unwrap();
+    let mut win = Win::with_size(Scrolled(cover), 64, 64).unwrap();
+    let scroller = win.role(Role::ScrollView).one().unwrap();
+    win.scroll_to(scroller, ScrollOffset { x: 0., y: 16. })
+        .unwrap();
+    compare(&mut win, &mut expected);
+    assert_eq!(win.with_scene(|s, _| s.images().count()).unwrap(), 1);
+}
