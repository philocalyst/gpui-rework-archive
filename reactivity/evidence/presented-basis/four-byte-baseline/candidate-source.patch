+#[test]
+fn basis_ordinary_window_allocation_cohorts() {
+    struct Cohort {
+        count: usize,
+        case: u8,
+    }
+    impl crate::View for Cohort {
+        fn view(&self) -> crate::El<'_> {
+            let root = crate::column((0..self.count).map(|index| {
+                let leaf = crate::div().w(32).h(1).bg(crate::Color::BLACK);
+                match self.case {
+                    5 if index == 0 => leaf.transform(Affine {
+                        a: 1.25,
+                        b: 0.125,
+                        ..Affine::IDENTITY
+                    }),
+                    6 => leaf.transform(Affine {
+                        a: 1.25,
+                        b: 0.125,
+                        ..Affine::IDENTITY
+                    }),
+                    7 => leaf.transform(Affine {
+                        a: 1.0 + (index + 1) as f32 / 1024.0,
+                        b: 0.125,
+                        ..Affine::IDENTITY
+                    }),
+                    _ => leaf,
+                }
+            }))
+            .w(128);
+            match self.case {
+                1 => root.name("root"),
+                2 => root.rounded(3.0),
+                3 => root.transform(Affine {
+                    a: 1.25,
+                    b: 0.125,
+                    d: 1.5,
+                    ..Affine::IDENTITY
+                }),
+                4 => root.transform(Affine {
+                    a: 1.25,
+                    d: 1.5,
+                    ..Affine::IDENTITY
+                }),
+                _ => root,
+            }
+        }
+    }
+    let options = WindowOptions {
+        size: [256, 256],
+        ..Default::default()
+    };
+    // Warm dependency TLS scratch outside each requested-allocation cohort.
+    drop(
+        Win::recording(
+            Cohort {
+                count: 1024,
+                case: 0,
+            },
+            options.clone(),
+        )
+        .unwrap(),
+    );
+    for count in [0, 1, 64, 1024] {
+        for (case, name) in [
+            "plain",
+            "named",
+            "rounded",
+            "custom_root",
+            "axis_root",
+            "sparse_custom",
+            "same_custom_siblings",
+            "unique_custom",
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            let mut held = None;
+            let cost = allocation_counter::measure(|| {
+                let mut win = Win::recording(
+                    Cohort {
+                        count,
+                        case: case as u8,
+                    },
+                    options.clone(),
+                )
+                .unwrap();
+                let token = win.with_scene(|_, token| token).unwrap();
+                win.presented(token).unwrap();
+                held = Some(win);
+            });
+            let runtime = held.as_ref().unwrap().runtime().unwrap();
+            let geometry = runtime
+                .metadata
+                .as_deref()
+                .and_then(|m| m.geometry.as_deref());
+            println!(
+                "BASIS_WINDOW case={name} children={count} rows={} row_capacity={} metadata={} geometry={} records={} record_capacity={} allocations={} requested={} retained={} peak={}",
+                runtime.presented.len(),
+                runtime.presented.capacity(),
+                runtime.metadata.is_some(),
+                geometry.is_some(),
+                geometry.map_or(0, |g| g.record_storage().0),
+                geometry.map_or(0, |g| g.record_storage().1),
+                cost.count_total,
+                cost.bytes_total,
+                cost.bytes_current,
+                cost.bytes_max
+            );
+            drop(held);
+        }
+    }
+}
