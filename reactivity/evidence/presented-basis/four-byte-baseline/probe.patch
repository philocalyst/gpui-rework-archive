+//! Test-only proposal pricing against the unchanged 6197888 production types.
+use super::*;
+
+#[allow(dead_code)]
+struct ProposedPlacement {
+    translation: Point,
+    size: [f32; 2],
+}
+#[allow(dead_code)]
+struct ProposedRow {
+    identity: u64,
+    parent: PresentedLink,
+    kind: NodeKind,
+    text: Option<SharedText>,
+    placement: ProposedPlacement,
+    basis: u32,
+    bounds: Rect,
+    hittable: bool,
+    actions: Actions,
+}
+#[allow(dead_code)]
+#[derive(Default)]
+struct SeparatePools {
+    presented: Vec<[f32; 4]>,
+    candidate: Option<Vec<[f32; 4]>>,
+}
+#[allow(dead_code)]
+#[derive(Default)]
+struct MetadataWithSeparatePools {
+    original: Metadata,
+    pools: Option<Box<SeparatePools>>,
+}
+#[allow(dead_code)]
+#[derive(Default)]
+struct GeometryWithSeparatePools {
+    original: geometry::Geometry,
+    pools: SeparatePools,
+}
+
+#[test]
+fn proposal_basis_headers_and_owner_allocations() {
+    macro_rules! header {
+        ($ty:ty) => {
+            println!("BASIS_PROPOSAL_HEADER {} size={} align={}", stringify!($ty), size_of::<$ty>(), std::mem::align_of::<$ty>());
+        };
+    }
+    header!(Presented);
+    header!(ProposedRow);
+    header!(ProposedPlacement);
+    header!(Prepared);
+    header!(Option<Prepared>);
+    header!(Runtime<()>);
+    header!(Metadata);
+    header!(geometry::Geometry);
+    header!((u64, crate::property::GeometryStyle));
+    header!([u32; 4]);
+    header!(SeparatePools);
+    header!(MetadataWithSeparatePools);
+    header!(GeometryWithSeparatePools);
+    assert_eq!(size_of::<ProposedRow>(), 64);
+    macro_rules! owner {
+        ($name:literal, $value:expr) => {{
+            let mut held = None;
+            let cost = allocation_counter::measure(|| held = Some($value));
+            println!("BASIS_PROPOSAL_OWNER {} allocations={} requested={} retained={} peak={}", $name, cost.count_total, cost.bytes_total, cost.bytes_current, cost.bytes_max);
+            drop(held);
+        }};
+    }
+    owner!("metadata_baseline", Box::<Metadata>::default());
+    owner!("metadata_separate_none", Box::<MetadataWithSeparatePools>::default());
+    owner!("rounded_geometry_baseline_and_shared_stream", Box::<geometry::Geometry>::default());
+    owner!("rounded_geometry_separate_direct", Box::<GeometryWithSeparatePools>::default());
+    owner!("custom_only_shared_headers", (Box::<Metadata>::default(), Box::<geometry::Geometry>::default()));
+    owner!("custom_only_sidecar_headers", (Box::<MetadataWithSeparatePools>::default(), Box::<SeparatePools>::default()));
+}
+
+#[test]
+fn basis_ordinary_window_allocation_cohorts() {
+    struct Cohort { count: usize, case: u8 }
+    impl crate::View for Cohort {
+        fn view(&self) -> crate::El<'_> {
+            let root = crate::column((0..self.count).map(|index| {
+                let leaf = crate::div().w(32).h(1).bg(crate::Color::BLACK);
+                match self.case {
+                    5 if index == 0 => leaf.transform(Affine { a: 1.25, b: 0.125, ..Affine::IDENTITY }),
+                    6 => leaf.transform(Affine { a: 1.25, b: 0.125, ..Affine::IDENTITY }),
+                    7 => leaf.transform(Affine { a: 1.0 + (index + 1) as f32 / 1024.0, b: 0.125, ..Affine::IDENTITY }),
+                    _ => leaf,
+                }
+            })).w(128);
+            match self.case {
+                1 => root.name("root"),
+                2 => root.rounded(3.0),
+                3 => root.transform(Affine { a: 1.25, b: 0.125, d: 1.5, ..Affine::IDENTITY }),
+                4 => root.transform(Affine { a: 1.25, d: 1.5, ..Affine::IDENTITY }),
+                _ => root,
+            }
+        }
+    }
+    let options = WindowOptions { size: [256, 256], ..Default::default() };
+    // Warm dependency TLS scratch outside each requested-allocation cohort.
+    drop(Win::recording(Cohort { count: 1024, case: 0 }, options.clone()).unwrap());
+    for count in [0, 1, 64, 1024] {
+        for (case, name) in ["plain", "named", "rounded", "custom_root", "axis_root", "sparse_custom", "same_custom_siblings", "unique_custom"].into_iter().enumerate() {
+            let mut held = None;
+            let cost = allocation_counter::measure(|| {
+                let mut win = Win::recording(Cohort { count, case: case as u8 }, options.clone()).unwrap();
+                let token = win.with_scene(|_, token| token).unwrap();
+                win.presented(token).unwrap();
+                held = Some(win);
+            });
+            let runtime = held.as_ref().unwrap().runtime().unwrap();
+            let geometry = runtime.metadata.as_deref().and_then(|m| m.geometry.as_deref());
+            println!("BASIS_WINDOW case={name} children={count} rows={} row_capacity={} metadata={} geometry={} records={} record_capacity={} allocations={} requested={} retained={} peak={}", runtime.presented.len(), runtime.presented.capacity(), runtime.metadata.is_some(), geometry.is_some(), geometry.map_or(0, |g| g.record_storage().0), geometry.map_or(0, |g| g.record_storage().1), cost.count_total, cost.bytes_total, cost.bytes_current, cost.bytes_max);
+            drop(held);
+        }
+    }
+}
