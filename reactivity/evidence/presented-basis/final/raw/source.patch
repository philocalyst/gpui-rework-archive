+    }
+    fn get(self, basis: MapBasis) -> Option<Basis> {
+        match basis.0 {
+            [MapBasis::INVALID, _] => None,
+            [MapBasis::POOLED, index] => Some(self.records[index as usize].basis()),
+            [a, d] => Some(Basis([a, 0, 0, d])),
