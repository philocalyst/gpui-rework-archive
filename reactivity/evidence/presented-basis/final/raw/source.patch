+#[test]
+fn proposal_basis_headers_and_owner_allocations() {
+    macro_rules! header {
+        ($ty:ty) => {
+            println!(
+                "BASIS_PROPOSAL_HEADER {} size={} align={}",
+                stringify!($ty),
+                size_of::<$ty>(),
+                std::mem::align_of::<$ty>()
+            );
+        };
+    }
+    #[cfg(feature = "accessibility")]
+    {
+        header!(accessibility::RowView<'_>);
+        header!(Option<accessibility::RowView<'_>>);
+        header!(accessibility::ComparedRows<'_, '_>);
+        assert_eq!(size_of::<accessibility::RowView<'_>>(), 24);
+        assert_eq!(size_of::<Option<accessibility::RowView<'_>>>(), 24);
+        assert_eq!(size_of::<accessibility::ComparedRows<'_, '_>>(), 48);
+    }
+    header!(Presented);
+    header!(Option<Presented>);
+    header!(geometry::Placement);
+    header!(geometry::MapBasis);
+    header!(geometry::Record);
+    header!(geometry::Bases<'_>);
+    header!(geometry::GeometryView<'_>);
+    header!(Affine);
+    header!(CoordinateSpace);
+    header!(Point);
+    header!(Rect);
+    header!(ProposedRow);
+    header!(ProposedPlacement);
+    header!(Prepared);
+    header!(Option<Prepared>);
+    header!(Runtime<()>);
+    header!(Metadata);
+    header!(geometry::Geometry);
+    header!((u64, crate::property::GeometryStyle));
+    header!([u32; 4]);
+    header!(SeparatePools);
+    header!(MetadataWithSeparatePools);
+    header!(GeometryWithSeparatePools);
+    assert_eq!(size_of::<ProposedRow>(), 64);
+    macro_rules! owner {
+        ($name:literal, $value:expr) => {{
+            let mut held = None;
+            let cost = allocation_counter::measure(|| held = Some($value));
+            println!(
+                "BASIS_PROPOSAL_OWNER {} allocations={} requested={} retained={} peak={}",
+                $name, cost.count_total, cost.bytes_total, cost.bytes_current, cost.bytes_max
+            );
+            drop(held);
+        }};
+    }
+    owner!("metadata_baseline", Box::<Metadata>::default());
+    owner!(
+        "metadata_separate_none",
+        Box::<MetadataWithSeparatePools>::default()
+    );
+    owner!(
+        "rounded_geometry_baseline_and_shared_stream",
+        Box::<geometry::Geometry>::default()
+    );
+    owner!(
+        "rounded_geometry_separate_direct",
+        Box::<GeometryWithSeparatePools>::default()
+    );
+    owner!(
+        "custom_only_shared_headers",
+        (
+            Box::<Metadata>::default(),
+            Box::<geometry::Geometry>::default()
+        )
+    );
+    owner!(
+        "custom_only_sidecar_headers",
+        (
+            Box::<MetadataWithSeparatePools>::default(),
+            Box::<SeparatePools>::default()
+        )
+    );
+}
