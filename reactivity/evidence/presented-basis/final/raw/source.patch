+    assert!(
+        runtime
+            .metadata
+            .as_ref()
+            .unwrap()
+            .geometry
+            .as_ref()
+            .unwrap()
+            .record_storage()
+            .0
+            > 0
+    );
+    ack(&mut win);
+    assert_eq!(projection(&win).map, expected(Affine::IDENTITY, 2.0));
+    assert_eq!(projection(&win).radius, 0);
+    assert!(
+        win.runtime()
+            .unwrap()
+            .metadata
+            .as_ref()
+            .is_none_or(|metadata| metadata.geometry.is_none())
+    );
+}
