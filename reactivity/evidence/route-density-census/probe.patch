+fn thin_header_request(size: usize, align: usize) -> (usize, usize) {
+    if size == 0 {
+        return (0, align);
+    }
+    let payload = Layout::from_size_align(size, align).expect("concrete route layout");
+    let (header, _) = Layout::new::<&'static ()>()
+        .extend(payload)
+        .expect("header plus concrete route layout");
+    let header = header.pad_to_align();
+    (header.size(), header.align())
+}
+fn route_summary(routes: &[RouteProbe]) -> RouteSummary {
+    let mut summary = RouteSummary::default();
+    for route in routes {
+        summary.objects += 1;
+        summary.zst += usize::from(route.size == 0);
+        summary.base_allocations += usize::from(route.size != 0);
+        summary.base_requested += route.size;
+        let (thin_request, _) = thin_header_request(route.thin_size, route.thin_align);
+        summary.thin_allocations += usize::from(route.thin_size != 0);
+        summary.thin_requested += thin_request;
+        *summary
+            .types
+            .entry((route.name, route.size, route.align, route.thin_size, route.thin_align))
+            .or_default() += 1;
+    }
+    summary
+}
+fn route_kind(name: &str, size: usize) -> &'static str {
+    if name.contains("ComponentRoute") {
+        "component-wrapper"
+    } else if name.contains("MethodRoute") {
+        if size == 0 { "captureless-method" } else { "captured-method" }
+    } else if name.contains("FieldAction") {
+        "field-action"
+    } else if name.contains("PropertyRoute") {
+        "property-action"
+    } else if name.contains("WindowAction") {
+        "window-action"
+    } else if size == 0 {
+        "other-zst"
+    } else {
+        "other-nonzero"
+    }
+}
+fn emit_route_summary(label: &str, routes: &[RouteProbe]) {
+    let summary = route_summary(routes);
+    println!(
+        "ROUTE_SUMMARY label={label} objects={} zst={} base_allocs={} thin_allocs={} base_requested={} thin_requested={} request_delta={}",
+        summary.objects,
+        summary.zst,
+        summary.base_allocations,
+        summary.thin_allocations,
+        summary.base_requested,
+        summary.thin_requested,
+        summary.thin_requested as isize - summary.base_requested as isize,
+    );
+    for ((name, size, align, thin_size, thin_align), count) in summary.types {
+        let (base_request, base_align) = if size == 0 { (0, align) } else { (size, align) };
+        let (thin_request, thin_request_align) = thin_header_request(thin_size, thin_align);
+        println!(
+            "ROUTE_TYPE label={label} kind={} name={name:?} count={count} base_payload={size}/{align} base_request={base_request}/{base_align} thin_payload={thin_size}/{thin_align} thin_request={thin_request}/{thin_request_align}",
+            route_kind(name, size),
+        );
+    }
+}
