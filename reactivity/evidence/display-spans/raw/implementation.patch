index 0000000000..55e16d2822
--- /dev/null
+++ b/reactivity/crates/display-span-lab/src/bin/consume.rs
@@ -0,0 +1,205 @@
+//! Execute exact compressed-word decoding and retained rect rendering on Vulkan.
+//! Portable staging writes, serialized completion; no shared-memory claim.
+use serde_json::{Value, json};
+use std::{fs, path::Path};
+fn bytes(words: &[u32]) -> Vec<u8> {
+    words.iter().flat_map(|w| w.to_le_bytes()).collect()
+}
+fn words(v: &Value) -> Vec<u32> {
+    v.as_array()
+        .unwrap()
+        .iter()
+        .map(|x| x.as_u64().unwrap().try_into().unwrap())
+        .collect()
+}
+fn buffer(device: &wgpu::Device, size: u64, usage: wgpu::BufferUsages) -> wgpu::Buffer {
+    device.create_buffer(&wgpu::BufferDescriptor {
+        label: None,
+        size: size.max(4),
+        usage,
+        mapped_at_creation: false,
+    })
+}
+fn read(device: &wgpu::Device, b: &wgpu::Buffer) -> Vec<u8> {
+    let (tx, rx) = std::sync::mpsc::channel();
+    b.map_async(wgpu::MapMode::Read, .., move |r| tx.send(r).unwrap());
+    device.poll(wgpu::PollType::wait_indefinitely()).unwrap();
+    rx.recv().unwrap().unwrap();
+    let result = b.get_mapped_range(..).unwrap().to_vec();
+    b.unmap();
+    result
+}
+fn main() {
+    let path = std::env::args().nth(1).expect("jobs.json path");
+    let jobs: Value = serde_json::from_slice(&fs::read(&path).unwrap()).unwrap();
+    pollster::block_on(async {
+        let mut desc = wgpu::InstanceDescriptor::new_without_display_handle();
+        desc.backends = wgpu::Backends::VULKAN;
+        let instance = wgpu::Instance::new(desc);
+        let adapter = instance
+            .request_adapter(&wgpu::RequestAdapterOptions {
+                force_fallback_adapter: true,
+                ..Default::default()
+            })
+            .await
+            .unwrap();
+        let info = adapter.get_info();
+        eprintln!("adapter={info:?}");
+        let (device, queue) = adapter
+            .request_device(&wgpu::DeviceDescriptor::default())
+            .await
+            .unwrap();
+        let shader = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("compressed display model"),
+            source: wgpu::ShaderSource::Wgsl(include_str!("../consume.wgsl").into()),
+        });
+        // Explicit common layout keeps decode-only unused bindings compatible.
+        let entries: Vec<_> = (0..4)
+            .map(|i| wgpu::BindGroupLayoutEntry {
+                binding: i,
+                visibility: wgpu::ShaderStages::COMPUTE,
+                ty: wgpu::BindingType::Buffer {
+                    ty: wgpu::BufferBindingType::Storage { read_only: i < 2 },
+                    has_dynamic_offset: false,
+                    min_binding_size: None,
+                },
+                count: None,
+            })
+            .collect();
+        let layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: None,
+            entries: &entries,
+        });
+        let pl = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+            label: None,
+            bind_group_layouts: &[Some(&layout)],
+            immediate_size: 0,
+        });
+        let pipeline = |entry| {
+            device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
+                label: None,
+                layout: Some(&pl),
+                module: &shader,
+                entry_point: Some(entry),
+                compilation_options: Default::default(),
+                cache: None,
+            })
+        };
+        let decode = pipeline("decode");
+        let render = pipeline("render");
+        let mut reports = Vec::new();
+        for series in jobs.as_array().unwrap() {
+            let arena_bytes = series["arena_words"].as_u64().unwrap() * 4;
+            let capacity = series["slots"].as_u64().unwrap() * 48;
+            let arena = buffer(
+                &device,
+                arena_bytes,
+                wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST,
+            );
+            let descriptor = buffer(
+                &device,
+                64,
+                wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST,
+            );
+            let pixels = buffer(
+                &device,
+                16384,
+                wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_SRC,
+            );
+            let decoded = buffer(
+                &device,
+                capacity,
+                wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_SRC,
+            );
+            let pixel_read = buffer(
+                &device,
+                16384,
+                wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+            );
+            let decode_read = buffer(
+                &device,
+                capacity,
+                wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+            );
+            let bindings = [&arena, &descriptor, &pixels, &decoded];
+            let entries: Vec<_> = bindings
+                .iter()
+                .enumerate()
+                .map(|(i, b)| wgpu::BindGroupEntry {
+                    binding: i as u32,
+                    resource: b.as_entire_binding(),
+                })
+                .collect();
+            let group = device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: None,
+                layout: &layout,
+                entries: &entries,
+            });
+            for job in series["jobs"].as_array().unwrap() {
+                let mut payload_bytes = 0usize;
+                let mut calls = 0;
+                for write in job["writes"].as_array().unwrap() {
+                    let data = bytes(&words(&write["words"]));
+                    queue.write_buffer(&arena, write["offset"].as_u64().unwrap() * 4, &data);
+                    payload_bytes += data.len();
+                    calls += 1;
+                }
+                let d = words(&job["descriptor"]);
+                queue.write_buffer(&descriptor, 0, &bytes(&d));
+                let mut encoder = device.create_command_encoder(&Default::default());
+                {
+                    let mut pass = encoder.begin_compute_pass(&Default::default());
+                    pass.set_bind_group(0, &group, &[]);
+                    pass.set_pipeline(&decode);
+                    pass.dispatch_workgroups((d[4] * 12).div_ceil(64), 1, 1);
+                    pass.set_pipeline(&render);
+                    pass.dispatch_workgroups(64, 1, 1);
+                }
+                encoder.copy_buffer_to_buffer(&pixels, 0, &pixel_read, 0, 16384);
+                encoder.copy_buffer_to_buffer(&decoded, 0, &decode_read, 0, capacity);
+                queue.submit([encoder.finish()]);
+                let actual_pixels = read(&device, &pixel_read);
+                let actual_words = read(&device, &decode_read);
+                let expected_pixels = fs::read(
+                    Path::new(&path)
+                        .parent()
+                        .unwrap()
+                        .join(job["pixels"].as_str().unwrap()),
+                )
+                .unwrap();
+                let expected_words = bytes(&words(&job["canonical"]));
+                let output = Path::new(&path).parent().unwrap().join("gpu-readback");
+                fs::create_dir_all(&output).unwrap();
+                let stem = format!(
+                    "{}-{}",
+                    series["name"].as_str().unwrap(),
+                    job["name"].as_str().unwrap()
+                );
+                fs::write(output.join(format!("{stem}.rgba")), &actual_pixels).unwrap();
+                fs::write(
+                    output.join(format!("{stem}.words")),
+                    &actual_words[..expected_words.len()],
+                )
+                .unwrap();
+                assert_eq!(
+                    actual_pixels, expected_pixels,
+                    "pixels {} {}",
+                    series["name"], job["name"]
+                );
+                assert_eq!(
+                    &actual_words[..expected_words.len()],
+                    expected_words,
+                    "decode {} {}",
+                    series["name"],
+                    job["name"]
+                );
+                reports.push(json!({"series":series["name"],"job":job["name"],"payload_bytes":payload_bytes,"descriptor_bytes":64,"queue_writes":calls+1,"submissions":1,"completion_waits":2,"gpu_arena_bytes":arena_bytes,"decode_output_bytes":capacity,"readback_bytes":capacity+16384,"pixels_exact":true,"words_exact":true}));
+            }
+        }
+        println!(
+            "{}",
+            serde_json::to_string_pretty(&json!({"adapter":format!("{info:?}"),"frames":reports}))
+                .unwrap()
+        );
+    });
+}
diff --git a/reactivity/crates/display-span-lab/src/bin/public_trace.rs b/reactivity/crates/display-span-lab/src/bin/public_trace.rs
new file mode 100644
index 0000000000..40b87a0f26
--- /dev/null
+++ b/reactivity/crates/display-span-lab/src/bin/public_trace.rs
@@ -0,0 +1,158 @@
+//! Ordinary existing GPUI APIs; diagnostic extraction is charged as a full scan.
+use gpui::{Error, WindowOptions, prelude::*};
+use serde_json::{Value, json};
+use std::{fs, path::Path};
+struct Panel {
+    color: Signal<Color>,
+    extra: Signal<bool>,
+    height: Signal<f64>,
+    transform: Signal<Affine>,
+}
+impl Panel {
+    const COLOR: Source<Self, Color> =
+        Source::new(FieldId::new(1), "color", |m| &m.color, |m| &mut m.color);
+    const EXTRA: Source<Self, bool> =
+        Source::new(FieldId::new(2), "extra", |m| &m.extra, |m| &mut m.extra);
+    const HEIGHT: Source<Self, f64> =
+        Source::new(FieldId::new(3), "height", |m| &m.height, |m| &mut m.height);
+    const TRANSFORM: Source<Self, Affine> = Source::new(
+        FieldId::new(4),
+        "transform",
+        |m| &m.transform,
+        |m| &mut m.transform,
+    );
+    fn new() -> Self {
+        Self {
+            color: Signal::new(Color::BLACK),
+            extra: Signal::new(false),
+            height: Signal::new(4.),
+            transform: Signal::new(Affine::IDENTITY),
+        }
+    }
+}
+impl View for Panel {
+    fn sources() -> Sources<Self> {
+        Sources::new()
+            .direct(Self::COLOR)
+            .field(Self::EXTRA)
+            .direct(Self::HEIGHT)
+            .direct(Self::TRANSFORM)
+    }
+    fn view(&self) -> El<'_> {
+        column((
+            div()
+                .name("surface")
+                .w(32)
+                .h(&self.height)
+                .bg(&self.color)
+                .transform(&self.transform),
+            (*self.extra).then(|| div().name("inserted").w(24).h(3).bg(Color::BLACK)),
+            (0..7).map(|_| div().w(32).h(4).bg(Color::BLACK)),
+        ))
+        .size(64)
+        .bg(Color::WHITE)
+        .clip()
+    }
+}
+fn capture(win: &mut Win<Panel>, root: &Path, name: &str, ack: bool) -> Value {
+    let (draws, token, clear) = win
+        .with_scene(|s, t| {
+            let draws: Vec<_> = s
+                .draws()
+                .map(|d| {
+                    assert!(d.clip_chain.is_none());
+                    assert!(d.color.iter().all(|c| *c == 0. || *c == 1.));
+                    let r = d.sampled_rect_clip([64, 64]).unwrap();
+                    assert!(
+                        [r.x, r.y, r.width, r.height]
+                            .iter()
+                            .all(|x| x.fract() == 0.)
+                    );
+                    json!({"rect":[r.x,r.y,r.x+r.width,r.y+r.height],"color":d.color})
+                })
+                .collect();
+            (draws, t, s.clear)
+        })
+        .unwrap();
+    let pixels = win.with_pixels(|p, _, _| p.to_vec()).unwrap();
+    fs::write(root.join(format!("public-{name}.rgba")), &pixels).unwrap();
+    // Independent full View reconstruction from the requested valid state.
+    // TRANSFORM intentionally remains identity after the rejected NaN request.
+    let mut oracle = Win::with_size(
+        Panel {
+            color: Signal::new(*win.read(Panel::COLOR).unwrap()),
+            extra: Signal::new(*win.read(Panel::EXTRA).unwrap()),
+            height: Signal::new(*win.read(Panel::HEIGHT).unwrap()),
+            transform: Signal::new(Affine::IDENTITY),
+        },
+        64,
+        64,
+    )
+    .unwrap();
+    let expected = oracle.with_pixels(|p, _, _| p.to_vec()).unwrap();
+    fs::write(root.join(format!("public-{name}-oracle.rgba")), &expected).unwrap();
+    assert_eq!(pixels, expected, "full public reconstruction {name}");
+    if ack {
+        win.presented(token).unwrap();
+    }
+    let snapshot = win.inspect().unwrap();
+    json!({"name":name,"accepted":ack,"snapshot":snapshot,"draws":draws,"clear":clear,"pixels":format!("public-{name}.rgba"),"counters":win.counters(),"adapter_snapshot_nodes":snapshot.nodes.len()})
+}
+fn main() {
+    let dir = std::env::args().nth(1).unwrap();
+    let root = Path::new(&dir);
+    fs::create_dir_all(root).unwrap();
+    let mut win = Win::recording(
+        Panel::new(),
+        WindowOptions {
+            size: [64, 64],
+            ..Default::default()
+        },
+    )
+    .unwrap();
+    let mut frames = vec![capture(&mut win, root, "initial", true)];
+    win.reset_counters().unwrap();
+    let target = win.query().name("surface").one().unwrap();
+    let commit = win.set(Panel::COLOR, Color::WHITE).unwrap();
+    assert_eq!(win.counters().owner_reruns, 0);
+    assert_eq!(win.counters().layout_runs, 0);
+    frames.push(capture(&mut win, root, "property", true));
+    assert_eq!(win.query().name("surface").one().unwrap(), target);
+    win.reset_counters().unwrap();
+    win.set(Panel::EXTRA, true).unwrap();
+    frames.push(capture(&mut win, root, "insertion", true));
+    assert_eq!(win.snapshot().unwrap().nodes.len(), 10);
+    assert_eq!(win.counters().owner_reruns, 1);
+    win.reset_counters().unwrap();
+    win.set(Panel::HEIGHT, 7.).unwrap();
+    frames.push(capture(&mut win, root, "layout", true));
+    win.reset_counters().unwrap();
+    win.set(Panel::EXTRA, false).unwrap();
+    frames.push(capture(&mut win, root, "removal", true));
+    assert_eq!(win.snapshot().unwrap().nodes.len(), 9);
+    assert_eq!(win.counters().owner_reruns, 1);
+    win.reset_counters().unwrap();
+    win.set(Panel::COLOR, Color::BLACK).unwrap();
+    let stale = win.with_scene(|_, t| t).unwrap();
+    frames.push(capture(&mut win, root, "invalidated", false));
+    win.set(Panel::COLOR, Color::WHITE).unwrap();
+    assert!(matches!(
+        win.presented(stale),
+        Err(Error::StalePresentation)
+    ));
+    frames.push(capture(&mut win, root, "latest", true));
+    win.set(Panel::COLOR, Color::BLACK).unwrap();
+    let eligible = win.with_scene(|_, t| t).unwrap();
+    assert!(
+        win.set(Panel::TRANSFORM, Affine::translation(f32::NAN, 0.))
+            .is_err()
+    );
+    assert_eq!(win.with_scene(|_, t| t).unwrap(), eligible);
+    frames.push(capture(&mut win, root, "failed-newer-eligible", true));
+    let report = json!({"source_property_commit":commit,"stale_rejected":true,"failed_newer_keeps_prior":true,"frames":frames,"scope":"rect-only CPU diagnostic acknowledgement; not native presentation; full snapshot adapter"});
+    fs::write(
+        root.join("public-trace.json"),
+        serde_json::to_vec_pretty(&report).unwrap(),
+    )
+    .unwrap();
+}
