+    #[test]
+    fn whole_pipeline_construction_and_retirement_are_monotonic_against_prior_owners() {
+        let token = token();
+        let mut cases = 0;
+        let rates = ORDINARY_RATES
+            .into_iter()
+            .flat_map(|source| {
+                ORDINARY_RATES
+                    .into_iter()
+                    .map(move |target| (source, target))
+            })
+            .chain([(81920, 78750), (78750, 81920)]);
+        for (source, target) in rates {
