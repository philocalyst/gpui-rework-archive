+            }
+            assert!(owner.phase == Phase::Idle);
+            assert_eq!(owner.output.as_ref().unwrap().accepted, expected);
+            assert_eq!(owner.output.as_ref().unwrap().queued, 0);
+            assert!(work_turns > 0 && blocked_turns > 0);
+        }
+    }
+    #[test]
+    fn actual_audio_owner_header_bill() {
