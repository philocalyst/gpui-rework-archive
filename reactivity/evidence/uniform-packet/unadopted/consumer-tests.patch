+fn record_upload_bytes(stats: Stats, width: u32, height: u32) -> usize {
+    stats.instance_upload_bytes
+        - (width.div_ceil(16) * height.div_ceil(16)) as usize * 8
+        - stats.tile_references * 4
+        - stats.correction_records * 32
+        - 48
