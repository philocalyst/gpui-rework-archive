+fn resource_words(mut resource: [u32; 3], common: u32, correction: u32) -> Word {
+    debug_assert!(correction <= CORRECTION_MASK);
+    if resource[0] == ROUNDED_SOURCE {
+        debug_assert_eq!(resource[2] & CORRECTION_MASK, 0);
