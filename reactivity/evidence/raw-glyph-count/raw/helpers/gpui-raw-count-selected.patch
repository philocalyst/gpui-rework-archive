+    /// Number of raw shaped glyphs in this run, restricted to its line if any.
+    pub fn glyph_count(&self) -> usize {
+        self.line_slice()
+            .shaped_clusters()
+            .iter()
+            .map(|cluster| cluster.glyph_len() as usize)
+            .sum()
+    }
