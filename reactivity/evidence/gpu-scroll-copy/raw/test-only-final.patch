+            scene.clear(Color::WHITE);
+            let rect = Rect::new(0., 0., 30., 30.);
+            let mut map = Affine::translation(10., 15. - offset);
+            match case {
+                0 => map.a = 1.25,
+                1 => {
+                    map.b = 0.25;
+                    map.c = -0.25;
+                }
+                2 => map.tx += 0.5,
