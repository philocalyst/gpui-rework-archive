+                        },
+                        Affine::IDENTITY,
+                    )
+                    .unwrap()
+                    .into()
+            } else if case == 4 {
+                Rect::new(5.5, 7., 59.5, 48.).into()
+            } else {
+                clip.into()
+            };
+            match case {
+                5 => scene
+                    .draw_image(&image, rect, map, clip, ImageSampling::Linear)
+                    .unwrap(),
+                6 => scene
+                    .fill_rounded_rect(rect, 3., map, clip, Color::BLACK)
+                    .unwrap(),
+                7 => scene
+                    .fill_rect(Rect::new(0.5, 0., 29.5, 30.), map, clip, Color::BLACK)
