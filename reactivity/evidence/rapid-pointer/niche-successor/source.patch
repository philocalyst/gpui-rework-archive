+        .unwrap();
+    assert_eq!(first.root().unwrap().calls, 0);
+    assert_eq!(second.root().unwrap().calls, 0);
+}
+
+#[test]
+fn cancellation_and_failed_new_press_consume_the_own_focus_proof() {
+    for event in [
+        PointerEvent::Cancel,
+        PointerEvent::Leave,
+        PointerEvent::Move(Point {
