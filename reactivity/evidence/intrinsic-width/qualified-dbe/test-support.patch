+//! Exact-width diagnostic; no production measurement hook or retained state.
+use super::*;
+
+#[test]
+#[ignore = "capture exact intrinsic/content width bits before selecting the fix"]
+fn intrinsic_content_width_round_trip() {
+    let face = gpui_canvas::FontFace::bundled().unwrap();
+    let mut shaper = face.shaper();
+    let natural = shaper.shape_interactive("Add", 16., None).unwrap();
+    println!(
+        "INTRINSIC natural={:?} bits={:#010x} height={:?} lines={}",
+        natural.width,
+        natural.width.to_bits(),
+        natural.height,
+        natural.retain_geometry().unwrap().lines().count()
+    );
+    for padding in [
+        cephal::Rect::splat(10.),
+        cephal::Rect {
+            left: 0.125,
+            right: 10.25,
+            top: 3.,
+            bottom: 3.,
+        },
+        cephal::Rect {
+            left: 1024.125,
+            right: 0.25,
+            top: 3.,
+            bottom: 3.,
+        },
+        cephal::Rect {
+            left: 1024.125,
+            right: 0.1,
+            top: 3.,
+            bottom: 3.,
+        },
+        cephal::Rect {
+            left: 0.1,
+            right: 1024.125,
+            top: 3.,
+            bottom: 3.,
+        },
+    ] {
+        let mut tree = LayoutTree::new();
+        let root = tree
+            .insert(
+                None,
+                gpui_reactivity_core::NodeKind::Element,
+                cephal::Style {
+                    display: cephal::style::Display::Flex,
+                    flex_direction: cephal::style::FlexDirection::Row,
+                    align_items: Some(cephal::style::AlignItems::CENTER),
+                    ..cephal::Style::DEFAULT
+                },
+            )
+            .unwrap();
+        let leaf = tree
+            .insert(
+                Some(root),
+                gpui_reactivity_core::NodeKind::Element,
+                cephal::Style {
+                    display: cephal::style::Display::Flex,
+                    padding: padding.map(cephal::style::LengthPercentage::length),
+                    flex_shrink: 0.,
+                    ..cephal::Style::DEFAULT
+                },
+            )
+            .unwrap();
+        tree.set_measure(leaf, Some(measure_marker)).unwrap();
+        tree.compute_with(root, Size {
+            width: AvailableSpace::Definite(4096.),
+            height: AvailableSpace::Definite(4096.),
+        }, &mut |id, input| {
+            assert_eq!(id, leaf);
+            let width = input.known_dimensions.width.or(match input.available_space.width {
+                AvailableSpace::Definite(width) => Some(width),
+                AvailableSpace::MinContent => Some(f32::MIN_POSITIVE),
+                AvailableSpace::MaxContent => None,
+            });
+            let shape = shaper.shape_interactive("Add", 16., width).unwrap();
+            println!("INTRINSIC measure padding={padding:?} input={input:?} width_bits={:?} shaped_width_bits={:#010x} height_bits={:#010x} lines={}", width.map(f32::to_bits), shape.width.to_bits(), shape.height.to_bits(), shape.retain_geometry().unwrap().lines().count());
+            MeasureOutput {
+                size: Size {
+                    width: input.known_dimensions.width.unwrap_or(shape.width),
+                    height: input.known_dimensions.height.unwrap_or(shape.height),
+                },
+                baselines: cephal::tree::Baselines::from_first(Some(shape.baseline)),
+            }
+        }).unwrap();
+        let layout = tree.layout(leaf).unwrap();
+        let grouped = layout.size.width - (layout.padding.left + layout.padding.right);
+        let final_content = layout.content_box_width();
+        println!(
+            "INTRINSIC final layout={layout:?} outer_bits={:#010x} grouped={grouped:?}/{:#010x} final_content={final_content:?}/{:#010x} natural={:#010x}",
+            layout.size.width.to_bits(),
+            grouped.to_bits(),
+            final_content.to_bits(),
+            natural.width.to_bits()
+        );
+    }
+}
+
+fn caption_layout(style: cephal::Style, available: f32) -> (cephal::tree::Layout, f32, usize) {
+    let face = gpui_canvas::FontFace::bundled().unwrap();
+    let mut shaper = face.shaper();
+    let mut tree = LayoutTree::new();
+    let root = tree
+        .insert(
+            None,
+            gpui_reactivity_core::NodeKind::Element,
+            cephal::Style {
+                display: cephal::style::Display::Flex,
+                flex_direction: cephal::style::FlexDirection::Row,
+                align_items: Some(cephal::style::AlignItems::CENTER),
+                ..cephal::Style::DEFAULT
+            },
+        )
+        .unwrap();
+    let leaf = tree
+        .insert(Some(root), gpui_reactivity_core::NodeKind::Element, style)
+        .unwrap();
+    tree.set_measure(leaf, Some(measure_marker)).unwrap();
+    let mut last_width = None;
+    let mut last_lines = 0;
+    tree.compute_with(
+        root,
+        Size {
+            width: AvailableSpace::Definite(available),
+            height: AvailableSpace::Definite(4096.),
+        },
+        &mut |_, input| {
+            let width = input
+                .known_dimensions
+                .width
+                .or(match input.available_space.width {
+                    AvailableSpace::Definite(width) => Some(width),
+                    AvailableSpace::MinContent => Some(f32::MIN_POSITIVE),
+                    AvailableSpace::MaxContent => None,
+                });
+            let shape = shaper.shape_interactive("Add", 16., width).unwrap();
+            last_width = width;
+            last_lines = shape.retain_geometry().unwrap().lines().count();
+            MeasureOutput {
+                size: Size {
+                    width: input.known_dimensions.width.unwrap_or(shape.width),
+                    height: input.known_dimensions.height.unwrap_or(shape.height),
+                },
+                baselines: cephal::tree::Baselines::from_first(Some(shape.baseline)),
+            }
+        },
+    )
+    .unwrap();
+    (tree.layout(leaf).unwrap(), last_width.unwrap(), last_lines)
+}
+
+#[test]
+fn measured_leaf_and_published_content_share_padding_border_and_gutter_budget() {
+    use cephal::style::{Display, LengthPercentage, Overflow};
+    let natural = gpui_canvas::FontFace::bundled()
+        .unwrap()
+        .shaper()
+        .shape_interactive("Add", 16., None)
+        .unwrap()
+        .width;
+    for padding in [
+        cephal::Rect::splat(10.),
+        cephal::Rect {
+            left: 0.125,
+            right: 10.25,
+            top: 3.,
+            bottom: 3.,
+        },
+        cephal::Rect {
+            left: 1024.125,
+            right: 0.1,
+            top: 3.,
+            bottom: 3.,
+        },
+        cephal::Rect {
+            left: 0.1,
+            right: 1024.125,
+            top: 3.,
+            bottom: 3.,
+        },
+    ] {
+        for gutter in [0., 0.05] {
+            let (layout, budget, lines) = caption_layout(
+                cephal::Style {
+                    display: Display::Flex,
+                    flex_shrink: 0.,
+                    padding: padding.map(LengthPercentage::length),
+                    border: cephal::Rect {
+                        left: 0.2,
+                        right: 0.3,
+                        top: 0.,
+                        bottom: 0.,
+                    }
+                    .map(LengthPercentage::length),
+                    overflow: cephal::Point {
+                        x: Overflow::Visible,
+                        y: Overflow::Scroll,
+                    },
+                    scrollbar_width: gutter,
+                    ..cephal::Style::DEFAULT
+                },
+                4096.,
+            );
+            assert_eq!(lines, 1, "{padding:?}, gutter={gutter}, {layout:?}");
+            assert!(budget >= natural, "{budget:?} < {natural:?}");
+            assert_eq!(
+                layout.content_box_width().to_bits(),
+                budget.to_bits(),
+                "{layout:?}"
+            );
+        }
+    }
+}
+
+#[test]
+fn explicit_maximum_and_flex_widths_do_not_gain_a_wrap_tolerance() {
+    use cephal::style::{Dimension, Display, LengthPercentage};
+    let short_outer = f32::from_bits(0x42479db2);
+    for constraint in 0..3 {
+        let mut style = cephal::Style {
+            display: Display::Flex,
+            flex_shrink: 0.,
+            padding: cephal::Rect::splat(LengthPercentage::length(10.)),
+            ..cephal::Style::DEFAULT
+        };
+        let available = match constraint {
+            0 => {
+                style.size.width = Dimension::length(short_outer);
+                4096.
+            }
+            1 => {
+                style.max_size.width = cephal::style::LengthPercentageAuto::length(short_outer);
+                4096.
+            }
+            _ => {
+                style.flex_shrink = 1.;
+                40.
+            }
+        };
+        let (layout, budget, lines) = caption_layout(style, available);
+        assert_eq!(lines, 2, "constraint={constraint}, {layout:?}");
+        assert_eq!(layout.content_box_width().to_bits(), budget.to_bits());
+        assert_eq!(
+            layout.size.width.to_bits(),
+            if constraint == 2 {
+                40f32.to_bits()
+            } else {
+                short_outer.to_bits()
+            }
+        );
+    }
+}
+
+#[test]
+fn measured_outer_overflow_is_explicit_and_finite_maximum_still_wins() {
+    use cephal::style::{Display, LengthPercentage, LengthPercentageAuto};
+    for maximum in [None, Some(f32::MAX)] {
+        let mut tree = LayoutTree::new();
+        let root = tree
+            .insert(
+                None,
+                gpui_reactivity_core::NodeKind::Element,
+                cephal::Style {
+                    display: Display::Flex,
+                    padding: cephal::Rect {
+                        left: f32::MAX,
+                        right: 0.,
+                        top: 0.,
+                        bottom: 0.,
+                    }
+                    .map(LengthPercentage::length),
+                    max_size: Size {
+                        width: maximum
+                            .map_or(LengthPercentageAuto::AUTO, LengthPercentageAuto::length),
+                        height: LengthPercentageAuto::AUTO,
+                    },
+                    ..cephal::Style::DEFAULT
+                },
+            )
+            .unwrap();
+        tree.set_measure(root, Some(measure_marker)).unwrap();
+        tree.compute_with(root, Size::MAX_CONTENT, &mut |_, _| {
+            MeasureOutput::from_size(Size {
+                width: 1.,
+                height: 1.,
+            })
+        })
+        .unwrap();
+        let width = tree.layout(root).unwrap().size.width;
+        assert_eq!(width, maximum.unwrap_or(f32::INFINITY));
+    }
+}
