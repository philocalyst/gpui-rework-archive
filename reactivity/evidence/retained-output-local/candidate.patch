+                ] {
+                    let edits = [SlotEdit::new(slots[1], PaintColor::new(color))];
+                    let damage = canvas.prepare_slots(&edits).unwrap().commit();
+                    gpu.patch_slots(&edits, &view, Some(damage)).unwrap();
