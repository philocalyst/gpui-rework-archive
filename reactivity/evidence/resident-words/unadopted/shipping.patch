new file mode 100644
index 0000000000..9415352d93
--- /dev/null
+++ b/reactivity/crates/gpu/src/renderer/changes.rs
@@ -0,0 +1,218 @@
+//! Temporary dirty bits occupy only private, otherwise unused packet bits.
+//! A failed prepare revokes residency; only clean words reach the GPU or replay.
+use super::{MAX_DRAWS, Word};
+use std::ops::Range;
+
+// An inline atlas.w holds a 17-bit correction index and SLOT_COLOR at bit 31.
+// A compact atlas.w holds a word address below 2^30. Shared common[4].y is
+// reserved zero. These fields become ordinary clean ABI words before upload;
+// only packet presence certifies that the retained words mirror the GPU.
+const INLINE_SHIFT: u32 = 17;
+const INLINE_MASK: u32 = 63 << INLINE_SHIFT;
+const PLACEMENT_SHIFT: u32 = 30;
+const PLACEMENT_MASK: u32 = 3 << PLACEMENT_SHIFT;
+const _: () = assert!(MAX_DRAWS < 1 << INLINE_SHIFT);
+const _: () = assert!(MAX_DRAWS * 8 + MAX_DRAWS / 32 + 1 < 1 << PLACEMENT_SHIFT);
+
+fn replace<const N: usize>(
+    old: &mut [Word],
+    mut next: [Word; N],
+    resident: bool,
+    metadata: Option<usize>,
+) -> u32 {
+    if let Some(index) = metadata {
+        next[index][..3].copy_from_slice(&old[index][..3]);
+    }
+    if !resident {
+        old.copy_from_slice(&next);
+        return 0;
+    }
+    let mut dirty = 0;
+    for (index, (old, next)) in old.iter_mut().zip(next).enumerate() {
+        if *old != next {
+            dirty |= 1 << index;
+        }
+        *old = next;
+    }
+    dirty
+}
+
+pub(super) fn common(old: &mut [Word], next: [Word; 5], resident: bool) {
+    let dirty = replace(old, next, resident, None);
+    old[4][1] = dirty;
+}
+pub(super) fn placement(old: &mut [Word], next: [Word; 2], resident: bool) {
+    let dirty = replace(old, next, resident, Some(1));
+    old[1][3] |= dirty << PLACEMENT_SHIFT;
+}
+pub(super) fn inline(old: &mut [Word], next: [Word; 6], resident: bool) {
+    let dirty = replace(old, next, resident, Some(5));
+    old[5][3] |= dirty << INLINE_SHIFT;
+}
+pub(super) fn metadata(record: &mut [Word], next: [u32; 3], compact: bool) {
+    let index = if compact { 1 } else { 5 };
+    if record[index][..3] != next {
+        record[index][..3].copy_from_slice(&next);
+        record[index][3] |= if compact {
+            2 << PLACEMENT_SHIFT
+        } else {
+            32 << INLINE_SHIFT
+        };
+    }
+}
+pub(super) fn take(record: &mut [Word], compact: bool) -> u32 {
+    let (word, mask, shift) = if compact {
+        (&mut record[1][3], PLACEMENT_MASK, PLACEMENT_SHIFT)
+    } else {
+        (&mut record[5][3], INLINE_MASK, INLINE_SHIFT)
+    };
+    let dirty = (*word & mask) >> shift;
+    *word &= !mask;
+    dirty
+}
+
+/// Reverse-order runs coalesce across record boundaries without a dirty Vec.
+#[derive(Default)]
+pub(super) struct Uploads(Option<Range<usize>>);
+impl Uploads {
+    pub(super) fn record<const N: usize>(
+        &mut self,
+        start: usize,
+        mut mask: u32,
+        records: &[Word],
+        emit: &mut impl FnMut(Range<usize>, &[Word]),
+    ) {
+        debug_assert!(N < 32 && mask >> N == 0);
+        if mask >> (N - 1) == 0 {
+            self.finish(records, emit);
+        }
+        // Visit dirty runs, not words. Empty records take no loop; a fully
+        // changed record extends the preceding run in one step.
+        while mask != 0 {
+            let end = (32 - mask.leading_zeros()) as usize;
+            let begin = end - (mask << (32 - end)).leading_ones() as usize;
+            self.extend(start + begin..start + end);
+            mask &= (1 << begin) - 1;
+            if begin != 0 {
+                self.finish(records, emit);
+            }
+        }
+    }
+    pub(super) fn prefix(
+        &mut self,
+        count: usize,
+        dirty: Range<usize>,
+        records: &[Word],
+        emit: &mut impl FnMut(Range<usize>, &[Word]),
+    ) {
+        if dirty.end != count || dirty.is_empty() {
+            self.finish(records, emit);
+        }
+        if !dirty.is_empty() {
+            let first = dirty.start;
+            self.extend(dirty);
+            if first != 0 {
+                self.finish(records, emit);
+            }
+        }
+    }
+    fn extend(&mut self, next: Range<usize>) {
+        if let Some(run) = &mut self.0 {
+            debug_assert_eq!(run.start, next.end);
+            run.start = next.start;
+        } else {
+            self.0 = Some(next);
+        }
+    }
+    pub(super) fn finish(
+        &mut self,
+        records: &[Word],
+        emit: &mut impl FnMut(Range<usize>, &[Word]),
+    ) {
+        if let Some(run) = self.0.take() {
+            emit(run, records);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn dirty_tags_preserve_every_final_word_and_resource_bit() {
+        for compact in [false, true] {
+            let count = if compact { 2 } else { 6 };
+            for mask in 0..1 << count {
+                let mut old = [[0x8000_0000, u32::MAX, 7, 0x8123_4567]; 6];
+                old[count - 1][3] = if compact { 524_289 } else { 0x8001_0000 };
+                let mut next = old;
+                for (index, word) in next[..count].iter_mut().enumerate() {
+                    if mask & (1 << index) != 0 {
+                        word[0] ^= 0x8000_0001;
+                    }
+                }
+                let expected = next;
+                // Resource words are deliberately finalized after construction.
+                let atlas = next[count - 1][..3].try_into().unwrap();
+                if compact {
+                    placement(&mut old[..2], next[..2].try_into().unwrap(), true);
+                } else {
+                    inline(&mut old, next, true);
+                }
+                metadata(&mut old[..count], atlas, compact);
+                assert_eq!(take(&mut old[..count], compact), mask);
+                assert_eq!(old, expected);
+            }
+        }
+        let mut old = [[u32::MAX; 4]; 5];
+        old[4] = [0x8001_0000, 0, 0, 0];
+        let next = old;
+        common(&mut old, next, true);
+        assert_eq!(old, next);
+    }
+
+    #[test]
+    fn reverse_uploads_are_exact_maximal_runs_across_record_boundaries() {
+        let records = [[u32::MAX; 4]; 12];
+        for mask in 0u32..4096 {
+            let mut uploads = Uploads::default();
+            let mut received = 0;
+            let mut runs: Vec<Range<usize>> = Vec::new();
+            let mut emit = |range: Range<usize>, words: &[Word]| {
+                assert_eq!(words, records);
+                for word in range.clone() {
+                    assert_ne!(mask & (1 << word), 0);
+                    assert_eq!(received & (1 << word), 0);
+                    received |= 1 << word;
+                }
+                runs.push(range);
+            };
+            uploads.record::<6>(6, mask >> 6, &records, &mut emit);
+            uploads.record::<6>(0, mask & 63, &records, &mut emit);
+            uploads.finish(&records, &mut emit);
+            assert_eq!(received, mask);
+            for pair in runs.windows(2) {
+                assert!(pair[1].end < pair[0].start, "adjacent runs must coalesce");
+            }
+        }
+    }
+
+    #[test]
+    fn failed_partially_tagged_packets_require_full_reconstruction() {
+        let mut old = [[u32::MAX; 4]; 6];
+        let mut next = old;
+        next[5][3] = 65_536;
+        inline(&mut old, next, false);
+        // Admission fails here, before resource finalization and tag removal.
+        let mut admitted = [[0; 4]; 6];
+        admitted[5][3] = 0x8001_0000;
+        inline(&mut old, admitted, false);
+        metadata(&mut old, [u32::MAX, 0x8000_0000, 7], false);
+        admitted[5][..3].copy_from_slice(&[u32::MAX, 0x8000_0000, 7]);
+        assert_ne!(take(&mut old, false) & 32, 0);
+        // The failed owner has no residency certificate; its caller ignores this
+        // sparse mask and uploads the complete clean packet.
+        assert_eq!(old, admitted);
+    }
+}
