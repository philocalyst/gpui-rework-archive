+            size_of::<Remote<()>>(),
+            size_of::<gpui::Inbox<()>>()
+        );
+        eprintln!(
+            "CONTROL_STORAGE,inbox_requests={},inbox_bytes={},inbox_retained={},queue_requests={},queue_bytes={},queue_retained={},queue_capacity={}",
+            inbox.count_total,
+            inbox.bytes_total,
+            inbox.bytes_current,
+            queue.count_total,
+            queue.bytes_total,
+            queue.bytes_current,
