+    Append,
+    Rewrite,
+}
+struct ControlTask {
+    operation: Control,
+    yielded: bool,
+}
+#[derive(Default)]
+struct Controls {
+    pending: VecDeque<ControlTask>,
+    wake: Option<Remote<()>>,
+    trace: bool,
+}
+impl Controls {
+    fn schedule(&mut self) {
+        if let Some(wake) = &self.wake {
+            match wake.try_send(()) {
+                Ok(()) | Err(SendError::Full(())) => {}
+                Err(SendError::Closed(())) => self.pending.clear(),
+            }
+        }
+    }
