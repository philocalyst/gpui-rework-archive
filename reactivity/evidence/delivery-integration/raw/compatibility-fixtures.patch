new file mode 100644
index 0000000000..c8368f6bfd
--- /dev/null
+++ b/reactivity/crates/gpui/examples/field_control.rs
@@ -0,0 +1,62 @@
+//! Public component/source delivery control. Allocation/work oracle, never timed.
+use gpui::{Affine, Component, El, FieldId, Inbox, LaneSet, Remote, Signal, Source, Sources, View, Win, div};
+use std::{hint::black_box, mem::{size_of, size_of_val}};
+struct Surface { map: Signal<Affine> }
+impl Surface {
+    const MAP: Source<Self, Affine> = Source::new(FieldId::new(1), "map", |m| &m.map, |m| &mut m.map);
+}
+impl View for Surface {
+    fn sources() -> Sources<Self> { Sources::new().direct(Self::MAP) }
+    fn view(&self) -> El<'_> { div().name("surface").w(24).h(16).transform(&self.map) }
+}
+struct Page { surface: Surface }
+impl Page {
+    const SURFACE: Component<Self, Surface> = Component::new(FieldId::new(1), "surface", |m| &m.surface, |m| &mut m.surface);
+    fn new() -> Self { Self { surface: Surface { map: Signal::new(Affine::IDENTITY) } } }
+}
+impl View for Page {
+    fn sources() -> Sources<Self> { Sources::new().direct_component(Self::SURFACE) }
+    fn view(&self) -> El<'_> { Self::SURFACE.view(self) }
+}
+// The paired coarse control changes only this binding and its expected work.
+const EXACT: bool = false;
+#[inline(never)]
+fn bind(inbox: Inbox<Affine>) -> Win<Page, impl LaneSet<Page>> {
+    Win::demo(Page::new()).with_inbox(inbox, |page: &mut Page, value| *page.surface.map = value).unwrap()
+}
+#[inline(never)]
+fn deliver<L: LaneSet<Page>>(win: &mut Win<Page, L>, budget: usize) { assert_eq!(win.deliver_ready(black_box(budget)).unwrap().applied, budget); }
+fn main() {
+    let mut owner = None;
+    let made = allocation_counter::measure(|| {
+        let (remote, inbox) = Remote::bounded(8);
+        owner = Some((remote, bind(inbox)));
+    });
+    let (remote, mut win) = owner.take().unwrap();
+    println!("owner bytes={} remote={} win={} {made:?}", size_of::<Remote<Affine>>() + size_of_val(&win), size_of_val(&remote), size_of_val(&win));
+    let source = &const { Page::SURFACE.source(&Surface::MAP) };
+    let target = win.query().name("surface").one().unwrap();
+    for batch in 0..3 {
+        let sent = allocation_counter::measure(|| for item in 0..8 {
+            remote.try_send(Affine::translation((batch * 8 + item + 1) as f32, 2.5)).unwrap();
+        });
+        assert_eq!(sent.count_total, 0);
+        win.reset_counters().unwrap();
+        let applied = allocation_counter::measure(|| deliver(black_box(&mut win), 8));
+        let map = *win.read(source).unwrap();
+        assert_eq!(map.tx, ((batch + 1) * 8) as f32);
+        assert_eq!(map.ty, 2.5);
+        assert_eq!(win.property(target, gpui::property::TRANSFORM).unwrap(), map);
+        let work = win.counters();
+        if EXACT {
+            assert_eq!(work.owner_reruns, 0);
+            assert_eq!(work.descriptions, 0);
+            assert_eq!(work.layout_runs, 0);
+            assert_eq!(work.measure_calls, 0);
+            assert_eq!(work.text_bytes_copied, 0);
+        } else { assert_eq!(work.owner_reruns, 1); }
+        println!("batch={batch} checksum={:08x}/{:08x} {work:?} {applied:?}", map.tx.to_bits(), map.ty.to_bits());
+    }
+    win.close();
+    assert!(remote.try_send(Affine::IDENTITY).is_err());
+}
diff --git a/reactivity/crates/gpui/examples/ordinary_control.rs b/reactivity/crates/gpui/examples/ordinary_control.rs
new file mode 100644
index 0000000000..3177cf695a
--- /dev/null
+++ b/reactivity/crates/gpui/examples/ordinary_control.rs
@@ -0,0 +1,56 @@
+//! Matched public owner/transport allocation and codegen control; never timed.
+use gpui::{Delivery, El, Inbox, Lane, Remote, View, Win, div};
+use std::{hint::black_box, mem::size_of};
+struct Page(u64);
+impl View for Page { fn view(&self) -> El<'_> { div() } }
+fn receive(page: &mut Page, value: u64) { page.0 += value; }
+type Owner = Win<Page, Lane<u64, fn(&mut Page, u64), ()>>;
+#[inline(never)]
+fn transport(capacity: usize) -> (Remote<u64>, Inbox<u64>) { Remote::bounded(capacity) }
+#[inline(never)]
+fn send(remote: &Remote<u64>, value: u64) -> bool { remote.try_send(value).is_ok() }
+#[inline(never)]
+fn clone_drop(remote: &Remote<u64>) { drop(remote.clone()); }
+#[inline(never)]
+fn deliver(owner: &mut Owner, budget: usize) -> Delivery { owner.deliver_ready(budget).unwrap() }
+#[inline(never)]
+fn ordinary(owner: &mut Win<Page>, value: u64) { owner.update(|page| page.0 += value).unwrap(); }
+fn main() {
+    println!("layout remote={} inbox={} owner={} empty={}", size_of::<Remote<u64>>(), size_of::<Inbox<u64>>(), size_of::<Owner>(), size_of::<Win<Page>>());
+    let mut plain = None;
+    let plain_new = allocation_counter::measure(|| plain = Some(Win::demo(Page(0))));
+    let mut plain = plain.take().unwrap();
+    let plain_update = allocation_counter::measure(|| ordinary(black_box(&mut plain), black_box(1)));
+    assert_eq!(plain.root().unwrap().0, 1);
+    println!("ordinary owner {plain_new:?}");
+    println!("ordinary update {plain_update:?}");
+    for capacity in [0, 1, 8, 64] {
+        let mut pair = None;
+        let cold = allocation_counter::measure(|| pair = Some(transport(black_box(capacity))));
+        println!("cold capacity={capacity} {cold:?}");
+        drop(pair.take());
+        let mut bound = None;
+        let owner = allocation_counter::measure(|| {
+            let (remote, inbox) = transport(black_box(capacity));
+            let win = Win::demo(Page(0)).with_inbox(inbox, receive as fn(&mut Page, u64)).unwrap();
+            bound = Some((remote, win));
+        });
+        println!("owner capacity={capacity} {owner:?}");
+        let (remote, mut win) = bound.take().unwrap();
+        let cloned = allocation_counter::measure(|| clone_drop(black_box(&remote)));
+        assert_eq!(cloned.count_total, 0);
+        let sent = allocation_counter::measure(|| for value in 0..capacity { assert!(send(black_box(&remote), black_box(value as u64))); });
+        assert_eq!(sent.count_total, 0);
+        assert!(!send(&remote, 999));
+        let mut report = None;
+        let applied = allocation_counter::measure(|| report = Some(deliver(black_box(&mut win), black_box(64))));
+        assert_eq!(report.unwrap().applied, capacity);
+        assert_eq!(win.root().unwrap().0, (0..capacity as u64).sum::<u64>());
+        println!("apply capacity={capacity} {applied:?}");
+        let idle = allocation_counter::measure(|| assert_eq!(deliver(black_box(&mut win), 64).applied, 0));
+        assert_eq!(idle.count_total, 0);
+        let closed = allocation_counter::measure(|| win.close());
+        println!("close capacity={capacity} {closed:?}");
+        assert!(!send(&remote, 42));
+    }
+}
