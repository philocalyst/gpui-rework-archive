{
  "x86_64-apple-darwin": [
    {
      "features": "[\"default\", \"metal\", \"std\", \"wgpu-core-deps-apple\", \"wgsl\"]",
      "rustflags": [
        "-C",
        "symbol-mangling-version=v0",
        "--cfg",
        "tokio_unstable"
      ]
    }
  ],
  "x86_64-pc-windows-msvc": [
    {
      "features": "[\"default\", \"dx12\", \"std\", \"wgpu-core-deps-windows-linux-android\", \"wgsl\"]",
      "rustflags": [
        "--cfg",
        "windows_slim_errors",
        "-C",
        "target-feature=+crt-static"
      ]
    }
  ],
  "wasm32-unknown-unknown": [
    {
      "features": "[\"default\", \"std\", \"webgl\", \"wgpu-core-deps-wasm\", \"wgsl\"]",
      "rustflags": [
        "-C",
        "symbol-mangling-version=v0",
        "--cfg",
        "tokio_unstable"
      ]
    }
  ]
}
