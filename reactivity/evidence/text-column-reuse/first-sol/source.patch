@@ -2,11 +2,48 @@
 use super::*;
 use std::sync::Arc;
 
+#[derive(Clone)]
 pub(super) struct Entry {
     pub row: u32,
     pub origin: Point,
     pub map: Arc<gpui_canvas::TextGeometry>,
 }
+pub(super) fn append<'a>(
+    candidate: &'a mut Option<Vec<Entry>>,
+    previous: &'a [Entry],
+    max_rows: usize,
+    index: usize,
+    row: u32,
+    origin: Point,
+    layout: &gpui_canvas::TextLayout,
+) -> &'a Entry {
+    if candidate.is_none()
+        && !previous.get(index).is_some_and(|entry| {
+            entry.row == row
+                && entry.origin.x.to_bits() == origin.x.to_bits()
+                && entry.origin.y.to_bits() == origin.y.to_bits()
+                && layout
+                    .geometry()
+                    .is_some_and(|map| std::ptr::eq(&*entry.map, map))
+        })
+    {
+        let mut column = Vec::with_capacity(previous.len().min(max_rows));
+        column.extend_from_slice(&previous[..index]);
+        *candidate = Some(column);
+    }
+    if let Some(column) = candidate {
+        column.push(Entry {
+            row,
+            origin,
+            map: layout
+                .retain_geometry()
+                .expect("interactive layout has geometry"),
+        });
+        column.last().unwrap()
+    } else {
+        &previous[index]
+    }
+}
 #[derive(Default)]
 pub(super) struct TextResources {
     pub system: Option<TextSystem>,
