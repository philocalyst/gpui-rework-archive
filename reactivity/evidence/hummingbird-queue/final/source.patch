+//! Decoder-facing plans, not a shared queue or a read-question side effect.
+//! A real decoder installs an owned Plan and returns its opaque EOS stamp.
+//! Audio decoding/device output are outside this queue contract.
+use crate::queue::{Entry, EntryKey, Navigation, Queue, QueueError, Repeat, Track, TrackRef};
+use std::{
+    num::NonZeroU64,
+    sync::atomic::{AtomicU64, Ordering},
+};
+
+static NEXT_SESSION: AtomicU64 = AtomicU64::new(0);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PlanStamp {
+    session: NonZeroU64,
+    serial: NonZeroU64,
+    entry: EntryKey,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct EndOfStream(PlanStamp);
+
+#[derive(Clone, Debug)]
+pub struct Plan {
+    stamp: PlanStamp,
+    pub current: Entry,
+    pub lookahead: Option<Entry>,
+}
+impl Plan {
+    /// A fresh stamp retires EOS authority. It does not alone request reopening
+    /// or seeking this path: edits reconcile lookahead while explicit play is a
+    /// restart intent. A future real decoder adapter must distinguish those
+    /// accepted intents instead of restarting the current file on every edit.
+    pub fn stamp(&self) -> PlanStamp {
+        self.stamp
+    }
+    pub fn end_of_stream(&self) -> EndOfStream {
+        EndOfStream(self.stamp)
+    }
+}
+
+/// Exclusive application controller. It is deliberately non-Clone; restoration
+/// creates a new session. The relaxed counter supplies identity only: a service
+/// channel/wake, not this counter, publishes a Plan to another thread.
+pub struct PlaybackQueue {
+    queue: Queue,
+    session: NonZeroU64,
+    serial: u64,
+    plan: Option<Plan>,
+}
+impl PlaybackQueue {
+    pub fn new() -> Result<Self, QueueError> {
+        let previous = NEXT_SESSION
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |value| {
+                value.checked_add(1)
+            })
+            .map_err(|_| QueueError::SessionExhausted)?;
+        Ok(Self {
+            queue: Queue::default(),
+            session: NonZeroU64::new(previous + 1)
+                .expect("the checked session counter starts above zero"),
+            serial: 0,
+            plan: None,
+        })
+    }
+    pub fn queue(&self) -> &Queue {
+        &self.queue
+    }
+    pub fn plan(&self) -> Option<&Plan> {
+        self.plan.as_ref()
+    }
+    fn next_serial(&self) -> Result<NonZeroU64, QueueError> {
+        self.serial
+            .checked_add(1)
+            .and_then(NonZeroU64::new)
+            .ok_or(QueueError::PlanExhausted)
+    }
+    fn install(&mut self, serial: NonZeroU64, available: &impl Fn(&Track) -> bool) {
+        self.serial = serial.get();
+        self.plan = self.queue.current().map(|key| {
+            let current = self
+                .queue
+                .entry(key)
+                .expect("the controller retains a live current key")
+                .clone();
+            let lookahead = self
+                .queue
+                .lookahead(available)
+                .map(|key| self.queue.entry(key).unwrap().clone());
+            Plan {
+                stamp: PlanStamp {
+                    session: self.session,
+                    serial,
+                    entry: key,
+                },
+                current,
+                lookahead,
+            }
+        });
+    }
+    fn refresh(&mut self, serial: NonZeroU64, available: &impl Fn(&Track) -> bool) {
+        if self.plan.is_some() {
+            self.install(serial, available);
+        } else {
+            // Even a stopped edit invalidates an older in-flight occurrence.
+            self.serial = serial.get();
+        }
+    }
+    fn navigate(
+        &mut self,
+        navigation: Navigation,
+        serial: NonZeroU64,
+        available: &impl Fn(&Track) -> bool,
+    ) {
+        match navigation {
+            Navigation::Changed(_) | Navigation::Repeat(_) => self.install(serial, available),
+            Navigation::End => {
+                self.serial = serial.get();
+                self.plan = None;
+            }
+        }
+    }
+    /// Explicit play/restart is an occurrence even for the same entry.
+    pub fn play(
+        &mut self,
+        key: EntryKey,
+        available: &impl Fn(&Track) -> bool,
+    ) -> Result<bool, QueueError> {
+        let serial = self.next_serial()?;
+        match self.queue.jump(key, available)? {
+            Navigation::Changed(_) => {
+                self.install(serial, available);
+                Ok(true)
+            }
+            Navigation::End => Ok(false),
+            Navigation::Repeat(_) => {
+                unreachable!("jump returns only a changed target or unavailable")
+            }
+        }
+    }
+    pub fn next(
+        &mut self,
+        available: &impl Fn(&Track) -> bool,
+        draw: &mut impl FnMut(usize) -> usize,
+    ) -> Result<(), QueueError> {
+        let serial = self.next_serial()?;
+        let navigation = self.queue.next(true, available, draw);
+        self.navigate(navigation, serial, available);
+        Ok(())
+    }
+    pub fn previous(
+        &mut self,
+        available: &impl Fn(&Track) -> bool,
+        draw: &mut impl FnMut(usize) -> usize,
+    ) -> Result<(), QueueError> {
+        let serial = self.next_serial()?;
+        let navigation = self.queue.previous(available, draw);
+        // At the start, Previous does nothing rather than stopping the plan.
+        if navigation != Navigation::End {
+            self.navigate(navigation, serial, available);
+        }
+        Ok(())
+    }
+    /// Duplicate/late EOS is inert, including after replacement of the whole
+    /// controller. RepeatOne creates a new occurrence before accepting EOS again.
+    pub fn end_of_stream(
+        &mut self,
+        event: EndOfStream,
+        available: &impl Fn(&Track) -> bool,
+        draw: &mut impl FnMut(usize) -> usize,
+    ) -> Result<bool, QueueError> {
+        if self.plan.as_ref().map(|plan| plan.stamp) != Some(event.0) {
+            return Ok(false);
+        }
+        let serial = self.next_serial()?;
+        let navigation = self.queue.next(false, available, draw);
+        self.navigate(navigation, serial, available);
+        Ok(true)
+    }
+    /// Revocation requires no fresh stamp and remains available at exhaustion.
+    pub fn stop(&mut self) {
+        self.plan = None;
+    }
+    pub fn append(
+        &mut self,
+        tracks: Vec<TrackRef>,
+        available: &impl Fn(&Track) -> bool,
+        draw: &mut impl FnMut(usize) -> usize,
+    ) -> Result<Option<EntryKey>, QueueError> {
+        let serial = self.next_serial()?;
+        let start = self.queue.len();
+        let first = self.queue.append(tracks, draw)?;
+        if first.is_some() {
+            if self.plan.is_none()
+                && let Some(key) = self.queue.available_from(start, available)
+            {
+                self.queue.jump(key, available)?;
+                self.install(serial, available);
+            } else {
+                self.refresh(serial, available);
+            }
+        }
+        Ok(first)
+    }
+    pub fn insert(
+        &mut self,
+        index: usize,
+        tracks: Vec<TrackRef>,
+        available: &impl Fn(&Track) -> bool,
+    ) -> Result<Option<EntryKey>, QueueError> {
+        let serial = self.next_serial()?;
+        let start = index.min(self.queue.len());
+        let count = tracks.len();
+        let first = self.queue.insert(index, tracks)?;
+        if first.is_some() {
+            let playable = (start..start + count)
+                .filter_map(|index| self.queue.at(index))
+                .find(|entry| available(&entry.track))
+                .map(|entry| entry.key);
+            if self.plan.is_none()
+                && let Some(key) = playable
+            {
+                self.queue.jump(key, available)?;
+                self.install(serial, available);
+            } else {
+                self.refresh(serial, available);
+            }
+        }
+        Ok(first)
+    }
+    pub fn remove(
+        &mut self,
+        keys: &[EntryKey],
+        available: &impl Fn(&Track) -> bool,
+    ) -> Result<bool, QueueError> {
+        let serial = self.next_serial()?;
+        let Some(removal) = self.queue.remove_with_position(keys) else {
+            return Ok(false);
+        };
+        if self.plan.is_some()
+            && self.queue.current().is_none()
+            && let Some(key) = removal
+                .next_index
+                .and_then(|index| self.queue.available_from(index, available))
+        {
+            self.queue.jump(key, available)?;
+        }
+        self.refresh(serial, available);
+        Ok(true)
+    }
+    pub fn move_entries(
+        &mut self,
+        keys: &[EntryKey],
+        destination: usize,
+        available: &impl Fn(&Track) -> bool,
+    ) -> Result<bool, QueueError> {
+        let serial = self.next_serial()?;
+        let changed = self.queue.move_entries(keys, destination);
+        if changed {
+            self.refresh(serial, available);
+        }
+        Ok(changed)
+    }
+    pub fn replace(
+        &mut self,
+        tracks: Vec<TrackRef>,
+        available: &impl Fn(&Track) -> bool,
+        draw: &mut impl FnMut(usize) -> usize,
+    ) -> Result<(), QueueError> {
+        let serial = self.next_serial()?;
+        self.queue.replace(tracks, draw)?;
+        if let Some(key) = self.queue.first_available(available) {
+            self.queue.jump(key, available)?;
+        }
+        self.install(serial, available);
+        Ok(())
+    }
+    pub fn clear(
+        &mut self,
+        keep_current: bool,
+        available: &impl Fn(&Track) -> bool,
+    ) -> Result<(), QueueError> {
+        let serial = self.next_serial()?;
+        self.queue.clear(keep_current && self.plan.is_some());
+        self.refresh(serial, available);
+        Ok(())
+    }
+    pub fn undo(&mut self, available: &impl Fn(&Track) -> bool) -> Result<bool, QueueError> {
+        let serial = self.next_serial()?;
+        let changed = self.queue.undo();
+        if changed {
+            self.refresh(serial, available);
+        }
+        Ok(changed)
+    }
+    pub fn toggle_shuffle(
+        &mut self,
+        available: &impl Fn(&Track) -> bool,
+        draw: &mut impl FnMut(usize) -> usize,
+    ) -> Result<(), QueueError> {
+        let serial = self.next_serial()?;
+        self.queue.toggle_shuffle(draw);
+        self.refresh(serial, available);
+        Ok(())
+    }
+    pub fn set_repeat(
+        &mut self,
+        repeat: Repeat,
+        available: &impl Fn(&Track) -> bool,
+    ) -> Result<bool, QueueError> {
+        let serial = self.next_serial()?;
+        let changed = self.queue.set_repeat(repeat);
+        if changed {
+            self.refresh(serial, available);
+        }
+        Ok(changed)
+    }
+    /// Call after accepted availability changes even if the current key stays
+    /// equal: the resolved lookahead and EOS policy belong to a new plan.
+    pub fn availability_changed(
+        &mut self,
+        available: &impl Fn(&Track) -> bool,
+    ) -> Result<(), QueueError> {
+        let serial = self.next_serial()?;
+        self.refresh(serial, available);
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn exhausted_plan_sequence_rejects_mutation_but_stop_still_revokes_eos() {
+        let track = TrackRef::new(Track {
+            path: "/prepared.flac".into(),
+            track_id: None,
+            album_id: None,
+            title: String::new(),
+            available_when_prepared: true,
+        });
+        let mut player = PlaybackQueue::new().unwrap();
+        player
+            .append(vec![track.clone()], &|_| true, &mut |_| 0)
+            .unwrap();
+        let key = player.queue.at(0).unwrap().key;
+        let event = player.plan().unwrap().end_of_stream();
+        player.serial = u64::MAX;
+        assert_eq!(player.play(key, &|_| true), Err(QueueError::PlanExhausted));
+        assert_eq!(
+            player.remove(&[key], &|_| true),
+            Err(QueueError::PlanExhausted)
+        );
+        assert_eq!(
+            player.replace(vec![track], &|_| true, &mut |_| 0),
+            Err(QueueError::PlanExhausted)
+        );
+        assert_eq!(player.queue.len(), 1);
+        assert_eq!(player.plan().unwrap().end_of_stream(), event);
+        player.stop();
+        assert!(player.plan().is_none());
+        assert!(!player.end_of_stream(event, &|_| true, &mut |_| 0).unwrap());
+    }
+}
diff --git a/reactivity/ports/hummingbird/src/queue_view.rs b/reactivity/ports/hummingbird/src/queue_view.rs
new file mode 100644
index 0000000000..683bd2022b
--- /dev/null
+++ b/reactivity/ports/hummingbird/src/queue_view.rs
@@ -0,0 +1,247 @@
+//! Ordinary public queue consumer. Explicit controls expose selection and range
+//! operations until modified-click/drag metadata has a portable public route.
+use crate::{
+    queue::{EntryKey, QueueError, Repeat, Track, TrackRef},
+    queue_playback::{EndOfStream, PlaybackQueue},
+};
+use gpui::prelude::*;
+
+pub struct QueueScreen {
+    playback: PlaybackQueue,
+    selected: Vec<EntryKey>,
+    anchor: Option<EntryKey>,
+    list: ListId,
+    notice: String,
+}
+fn available(track: &Track) -> bool {
+    track.available_when_prepared
+}
+fn draw(upper: usize) -> usize {
+    fastrand::usize(..upper)
+}
+impl QueueScreen {
+    /// `list` names this queue's key domain. Reconstructing a screen in the same
+    /// window requires a fresh ListId; ordinary edits keep monotonically fresh
+    /// entry keys and preserve this domain. One Library owns one screen.
+    pub fn new(list: ListId) -> Result<Self, QueueError> {
+        Ok(Self {
+            playback: PlaybackQueue::new()?,
+            selected: Vec::new(),
+            anchor: None,
+            list,
+            notice: String::new(),
+        })
+    }
+    pub fn list_id(&self) -> ListId {
+        self.list
+    }
+    pub fn playback(&self) -> &PlaybackQueue {
+        &self.playback
+    }
+    pub fn selected(&self) -> &[EntryKey] {
+        &self.selected
+    }
+    pub fn enqueue(&mut self, track: TrackRef) {
+        self.enqueue_many(vec![track]);
+    }
+    pub fn enqueue_many(&mut self, tracks: Vec<TrackRef>) {
+        let result = self.playback.append(tracks, &available, &mut draw);
+        self.changed(result.map(|_| ()));
+    }
+    /// The application may bind this to its real decoder's typed Inbox. The
+    /// queue UI itself never fabricates EOS or installs an audio side effect.
+    pub fn receive_end_of_stream(&mut self, event: EndOfStream) {
+        match self.playback.end_of_stream(event, &available, &mut draw) {
+            Ok(true) => self.changed(Ok(())),
+            Ok(false) => {}
+            Err(error) => self.changed(Err(error)),
+        }
+    }
+    fn changed(&mut self, result: Result<(), QueueError>) {
+        match result {
+            Ok(()) => {
+                // Original queue-update notification clears selection too.
+                self.selected.clear();
+                self.anchor = None;
+                self.notice.clear();
+            }
+            Err(error) => self.notice = format!("Queue rejected: {error:?}"),
+        }
+    }
+    pub fn select(&mut self, key: EntryKey) {
+        if self.playback.queue().entry(key).is_some() {
+            self.selected.clear();
+            self.selected.push(key);
+            self.anchor = Some(key);
+        }
+    }
+    pub fn toggle(&mut self, key: EntryKey) {
+        if self.playback.queue().entry(key).is_none() {
+            return;
+        }
+        match self.selected.binary_search(&key) {
+            Ok(index) => {
+                self.selected.remove(index);
+                if self.anchor == Some(key) {
+                    self.anchor = self.selected.first().copied();
+                }
+            }
+            Err(index) => {
+                self.selected.insert(index, key);
+                self.anchor = Some(key);
+            }
+        }
+    }
+    pub fn range(&mut self, key: EntryKey) {
+        let queue = self.playback.queue();
+        let Some(index) = queue.index_of(key) else {
+            return;
+        };
+        let anchor = self.anchor.or(queue.current()).unwrap_or(key);
+        let Some(start) = queue.index_of(anchor) else {
+            return;
+        };
+        self.anchor = Some(anchor);
+        self.selected = (start.min(index)..=start.max(index))
+            .map(|index| queue.at(index).unwrap().key)
+            .collect();
+        self.selected.sort_unstable();
+    }
+    fn play(&mut self, key: EntryKey) {
+        let result = self.playback.play(key, &available);
+        self.changed(result.and_then(|accepted| {
+            if accepted {
+                Ok(())
+            } else {
+                Err(QueueError::Unavailable)
+            }
+        }));
+    }
+    fn next(&mut self) {
+        let result = self.playback.next(&available, &mut draw);
+        self.changed(result);
+    }
+    fn previous(&mut self) {
+        let result = self.playback.previous(&available, &mut draw);
+        self.changed(result);
+    }
+    fn remove(&mut self) {
+        let result = self.playback.remove(&self.selected, &available);
+        self.changed(result.map(|_| ()));
+    }
+    fn move_to(&mut self, destination: usize) {
+        let result = self
+            .playback
+            .move_entries(&self.selected, destination, &available);
+        self.changed(result.map(|_| ()));
+    }
+    fn shuffle(&mut self) {
+        let result = self.playback.toggle_shuffle(&available, &mut draw);
+        self.changed(result);
+    }
+    fn repeat(&mut self) {
+        let next = match self.playback.queue().repeat() {
+            Repeat::Off => Repeat::All,
+            Repeat::All => Repeat::One,
+            Repeat::One => Repeat::Off,
+        };
+        let result = self.playback.set_repeat(next, &available);
+        self.changed(result.map(|_| ()));
+    }
+    fn undo(&mut self) {
+        let result = self.playback.undo(&available);
+        self.changed(result.map(|_| ()));
+    }
+    fn clear(&mut self) {
+        let result = self.playback.clear(true, &available);
+        self.changed(result);
+    }
+}
+impl ItemSource for QueueScreen {
+    fn len(&self) -> usize {
+        self.playback.queue().len()
+    }
+    fn key(&self, index: usize) -> ItemKey {
+        ItemKey::new(self.playback.queue().at(index).unwrap().key.get())
+    }
+    fn index_of(&self, key: ItemKey) -> Option<usize> {
+        let queue = self.playback.queue();
+        queue.index_of(queue.key(key.get())?)
+    }
+    fn row(&self, index: usize) -> El<'_> {
+        let entry = self.playback.queue().at(index).unwrap();
+        let key = entry.key;
+        let play = button("Prepare")
+            .name(format!("Prepare {}", entry.track.title))
+            .w(80);
+        row((
+            checkbox(
+                entry.track.title.as_str(),
+                self.selected.binary_search(&key).is_ok(),
+            )
+            .description("Select or unselect this queued recording")
+            .w(240)
+            .on_click(move |model: &mut Self| model.toggle(key)),
+            button("Only")
+                .name(format!("Select only {}", entry.track.title))
+                .w(55)
+                .on_click(move |model: &mut Self| model.select(key)),
+            button("Range")
+                .name(format!("Select range to {}", entry.track.title))
+                .w(70)
+                .on_click(move |model: &mut Self| model.range(key)),
+            if available(&entry.track) {
+                play.on_click(move |model: &mut Self| model.play(key))
+            } else {
+                play.description("Path was unavailable when prepared by the library worker")
+            },
+        ))
+        .h(40)
+        .bg(if self.playback.queue().current() == Some(key) {
+            rgb(0xe0f2fe)
+        } else {
+            Color::WHITE
+        })
+    }
+}
+impl View for QueueScreen {
+    fn view(&self) -> El<'_> {
+        let last = self.playback.queue().len();
+        column((
+            text(format!("Queue — {} entries", last)).font_size(20),
+            text("Decoder plans only; audio output is not attached"),
+            row((
+                button("Previous").on_click(Self::previous),
+                button("Next").on_click(Self::next),
+                checkbox("Shuffle queue", self.playback.queue().shuffled()).on_click(Self::shuffle),
+                button(format!("Repeat: {:?}", self.playback.queue().repeat()))
+                    .on_click(Self::repeat),
+                button("Undo queue edit").on_click(Self::undo),
+                button("Clear upcoming").on_click(Self::clear),
+            ))
+            .gap(8),
+            row((
+                button("Remove selected").on_click(Self::remove),
+                button("Move selected first").on_click(|model: &mut Self| model.move_to(0)),
+                button("Move selected last").on_click(move |model: &mut Self| model.move_to(last)),
+            ))
+            .gap(8),
+            uniform_list(self.list, self, 40)
+                .name("Playback queue")
+                .w(650)
+                .h(160),
+            text(self.playback.plan().map_or_else(
+                || "No decoder plan".into(),
+                |plan| {
+                    format!(
+                        "Prepared {} — {}",
+                        plan.current.track.title,
+                        plan.current.track.path.display()
+                    )
+                },
+            )),
+            text(self.notice.as_str()),
+        ))
+        .gap(6)
+    }
+}
