+                assert!(gpu.redraw(&view).unwrap().is_none());
+                gpu.render_regions(canvas.prepared_scene(), &view, &DamageRegions::default())
+                    .unwrap();
+                assert_eq!(
+                    gpu.retained_stats().composited_pixels,
