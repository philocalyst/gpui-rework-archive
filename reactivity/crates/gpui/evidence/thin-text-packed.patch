+/// Frozen routing metadata in one word. The low 24 bits encode parent+1;
+/// the high byte holds the closed kind, hit flag, and four advertised actions.
+#[derive(Clone, Copy)]
+struct PresentedHeader(u32);
+impl PresentedHeader {
+    #[inline]
+    fn new(parent: Parent, kind: NodeKind, hittable: bool, actions: Actions) -> Self {
+        const { assert!(MAX_NODES < 1 << 24) };
+        let kind = match kind {
+            NodeKind::Div => 0,
+            NodeKind::Text => 1,
+            NodeKind::Input => 2,
+            NodeKind::Button => 3,
+            NodeKind::List => 4,
+            NodeKind::ListItem => 5,
+        };
+        Self(
+            parent.0.wrapping_add(1)
+                | (kind << 24)
+                | (u32::from(hittable) << 27)
+                | (u32::from(actions.bits()) << 28),
+        )
+    }
+    #[inline]
+    fn parent(self) -> Parent {
+        Parent((self.0 & 0x00ff_ffff).wrapping_sub(1))
+    }
+    #[inline]
+    fn kind(self) -> NodeKind {
+        match (self.0 >> 24) & 7 {
+            0 => NodeKind::Div,
+            1 => NodeKind::Text,
+            2 => NodeKind::Input,
+            3 => NodeKind::Button,
+            4 => NodeKind::List,
+            5 => NodeKind::ListItem,
+            _ => unreachable!("only closed admitted kinds are encoded"),
+        }
+    }
+    #[inline]
+    fn hittable(self) -> bool {
+        self.0 & (1 << 27) != 0
+    }
+    #[inline]
+    fn actions(self) -> Actions {
+        Actions::from_bits((self.0 >> 28) as u8)
+    }
+}
+#[cfg(test)]
+mod presented_header_tests {
+    use super::*;
+
+    #[test]
+    fn packed_frozen_metadata_preserves_all_parents_kinds_and_action_sets() {
+        assert_eq!(size_of::<PresentedHeader>(), 4);
+        assert_eq!(size_of::<Presented>(), 80);
+        let kinds = [
+            NodeKind::Div,
+            NodeKind::Text,
+            NodeKind::Input,
+            NodeKind::Button,
+            NodeKind::List,
+            NodeKind::ListItem,
+        ];
+        for kind in kinds {
+            for index in 0..MAX_NODES {
+                let actions = Actions::from_bits((index & 15) as u8);
+                let hittable = index & 16 != 0;
+                let header =
+                    PresentedHeader::new(Parent::new(Some(index)), kind, hittable, actions);
+                assert_eq!(header.parent().index(), Some(index));
+                assert_eq!(header.kind(), kind);
+                assert_eq!(header.hittable(), hittable);
+                assert_eq!(header.actions(), actions);
+            }
+            for parent in [None, Some(0), Some(MAX_NODES - 1)] {
+                for bits in 0..16 {
+                    for hittable in [false, true] {
+                        let actions = Actions::from_bits(bits);
+                        let header =
+                            PresentedHeader::new(Parent::new(parent), kind, hittable, actions);
+                        assert_eq!(header.parent().index(), parent);
+                        assert_eq!(header.kind(), kind);
+                        assert_eq!(header.hittable(), hittable);
+                        assert_eq!(header.actions(), actions);
+                    }
+                }
+            }
+        }
+    }
+}
