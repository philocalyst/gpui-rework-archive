diff --git a/crates/zgui-render-wgpu/src/bench_present.rs b/crates/zgui-render-wgpu/src/bench_present.rs
new file mode 100644
index 0000000..cc529f9
--- /dev/null
+++ b/crates/zgui-render-wgpu/src/bench_present.rs
@@ -0,0 +1,48 @@
+//! Bounded successful WGPU surface-present receipts for the Todo adapter.
+//! These are backend submission times, not compositor acknowledgement or scanout.
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+const LIMIT: usize = 200_000;
+static START: OnceLock<Instant> = OnceLock::new();
+static SEQUENCE: AtomicU64 = AtomicU64::new(0);
+static RECEIPTS: OnceLock<Mutex<Vec<(u64, u64)>>> = OnceLock::new();
+static OVERFLOW: AtomicU64 = AtomicU64::new(0);
+/// Set the relative timestamp origin at application entry.
+pub fn start() {
+    let _ = START.set(Instant::now());
+}
+/// Record after the successful `SurfaceTexture::present()` return.
+pub fn record(info: &wgpu::AdapterInfo) {
+    let Some(start) = START.get() else {
+        return;
+    };
+    let ns = u64::try_from(start.elapsed().as_nanos()).unwrap_or(u64::MAX);
+    let seq = SEQUENCE.fetch_add(1, Ordering::Relaxed) + 1;
+    if seq == 1 {
+        eprintln!(
+            "TODO_RENDERER,wgpu:{:?}:{:?}:{:04x}:{:04x}:{}",
+            info.backend, info.device_type, info.vendor, info.device, info.name
+        );
+        eprintln!("TODO_FIRST_PRESENT,{ns}");
+    }
+    let records = RECEIPTS.get_or_init(|| Mutex::new(Vec::with_capacity(4096)));
+    let mut records = records.lock().unwrap_or_else(|p| p.into_inner());
+    if records.len() < LIMIT {
+        records.push((seq, ns));
+    } else {
+        OVERFLOW.fetch_add(1, Ordering::Relaxed);
+    }
+}
+/// Drain buffered `(sequence, elapsed_ns)` receipts and overflow count.
+pub fn take() -> (Vec<(u64, u64)>, u64) {
+    let records = RECEIPTS.get_or_init(|| Mutex::new(Vec::new()));
+    let values = std::mem::take(&mut *records.lock().unwrap_or_else(|p| p.into_inner()));
+    (values, OVERFLOW.load(Ordering::Relaxed))
+}
+
+/// Successful first-presentation epoch used by the benchmark animation scheduler.
+pub fn first_present_time() -> Option<Instant> {
+    let records = RECEIPTS.get()?.lock().ok()?;
+    Some(*START.get()? + Duration::from_nanos(records.first()?.1))
+}
