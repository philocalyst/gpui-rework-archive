diff --git a/examples/benchmark-todo/main.zig b/examples/benchmark-todo/main.zig
new file mode 100644
index 0000000..0b93ab8
--- /dev/null
+++ b/examples/benchmark-todo/main.zig
@@ -0,0 +1,189 @@
+//! Ordinary Todo adapter using public immediate UI APIs, with eager rows.
+const std = @import("std");
+const nanoui = @import("nanoui");
+const ui = nanoui.ui;
+const Task = struct { id: u64, title: []const u8, done: bool = false };
+const Filter = enum { all, active, done };
+const Deleted = struct { index: usize, task: Task };
+var current: ?*Todos = null;
+
+// Called by the benchmark-only GTK presentation hook after GL drawing or
+// cairo_paint. This is a host drawing boundary, not a physical scanout.
+pub fn todoBenchPresented(backend: []const u8) void {
+    const s = current orelse return;
+    const now = ui.clock.now();
+    const elapsed: u64 = @intFromFloat(@max(0, now - s.started) * 1e9);
+    if (s.frame_count == 0) {
+        s.epoch = now;
+        std.debug.print("TODO_RENDERER,{s}\nTODO_FIRST_PRESENT,{d}\n", .{ backend, elapsed });
+    }
+    if (s.frame_count < s.frames.len) {
+        s.frames[s.frame_count] = elapsed;
+        s.frame_count += 1;
+    } else {
+        s.overflow += 1;
+    }
+}
+const Todos = struct {
+    gpa: std.mem.Allocator,
+    rows: std.ArrayList(Task) = .empty,
+    draft: ui.TextBuffer = .{},
+    filter: Filter = .all,
+    next_id: u64 = 0,
+    deleted: ?Deleted = null,
+    callbacks: u64 = 0,
+    actions: std.ArrayList([]const u8) = .empty,
+    ticks: u64 = 0,
+    skipped: u64 = 0,
+    animate: bool = false,
+    started: f64,
+    epoch: ?f64 = null,
+    frames: [20000]u64 = undefined,
+    frame_count: usize = 0,
+    overflow: u64 = 0,
+
+    fn emit(s: *Todos, tag: []const u8, value: anytype) void {
+        const json = std.json.Stringify.valueAlloc(s.gpa, value, .{}) catch @panic("serialize observer");
+        defer s.gpa.free(json);
+        std.debug.print("{s},{s}\n", .{ tag, json });
+    }
+    fn action(s: *Todos, kind: []const u8) void {
+        s.callbacks += 1;
+        s.actions.append(s.gpa, kind) catch @panic("append action receipt");
+        s.emit("TODO_ACTION", .{ .action = kind, .callbacks = s.callbacks, .rows = s.rows.items.len, .draft = s.draft.text(), .filter = @tagName(s.filter) });
+    }
+    fn button(c: *ui.Context, name: []const u8, width: ui.Length, color: u24) bool {
+        ui.key(c, name);
+        const hit = ui.pressable(c, .{ .direction = .row, .height = .{ .px = 37.792 }, .width = width, .padding = .all(8), .background = .hex(color), .control = true }, null);
+        ui.text(c, name, .{ .size = 16, .color = .hex(0x0f172a) });
+        ui.end(c);
+        if (hit.clicked) c.changed = true;
+        return hit.clicked;
+    }
+    fn view(s: *Todos, c: *ui.Context) void {
+        var offset: f32 = 0;
+        if (s.animate and s.epoch == null) c.frameIn(1.0 / 60.0);
+        if (s.animate) if (s.epoch) |epoch| {
+            const now = ui.clock.now();
+            const scheduled: u64 = @intFromFloat(@max(0, now - epoch) * 60);
+            if (scheduled > s.ticks + s.skipped) {
+                s.skipped += scheduled - s.ticks - s.skipped - 1;
+                s.ticks += 1;
+            }
+            offset = @floatCast(12 * @sin(@as(f64, @floatFromInt(scheduled)) / 60 * std.math.tau));
+            c.frameIn(@floatCast(@max(0.001, epoch + @as(f64, @floatFromInt(scheduled + 1)) / 60 - now)));
+        };
+        var toggle: ?usize = null;
+        var remove: ?usize = null;
+        ui.column(c, .{ .width = .{ .px = 540 }, .height = .{ .px = 620 }, .padding = .all(24), .gap = 12 });
+        ui.text(c, "Todos", .{ .size = 28, .color = .hex(0x172554) });
+        ui.row(c, .{ .height = .{ .px = 41.792 }, .gap = 8 });
+        ui.column(c, .{ .width = .{ .px = 280 }, .height = .{ .px = 41.792 }, .padding = .all(10), .background = .hex(0xf1f5f9) });
+        ui.key(c, "draft");
+        _ = ui.textField(c, &s.draft, .{ .width = .fill, .size = 16, .bare = true, .placeholder = "New task" });
+        ui.end(c);
+        if (button(c, "Add", .{ .px = 56 }, 0xc7d2fe)) {
+            const title = std.mem.trim(u8, s.draft.text(), " \t\n\r");
+            if (title.len != 0) {
+                const owned = s.gpa.dupe(u8, title) catch @panic("allocate title");
+                s.rows.append(s.gpa, .{ .id = s.next_id, .title = owned }) catch @panic("append task");
+                s.next_id += 1;
+                s.draft.clear();
+                s.action("add");
+            }
+        }
+        ui.end(c);
+        ui.key(c, "viewport");
+        ui.scroll(c, .{ .width = .{ .px = 492 }, .height = .{ .px = 360 } });
+        ui.column(c, .{ .width = .{ .px = 492 }, .gap = 6, .offset = .{ .y = offset } });
+        for (s.rows.items, 0..) |task, index| {
+            if (s.filter == .active and task.done or s.filter == .done and !task.done) continue;
+            ui.key(c, c.print("task-{d}", .{task.id}));
+            ui.row(c, .{ .height = .{ .px = 37.792 }, .gap = 8 });
+            if (button(c, if (task.done) "Reopen" else "Complete", .{ .px = 100 }, 0xe2e8f0)) toggle = index;
+            ui.column(c, .{ .width = .{ .px = 220 }, .height = .{ .px = 37.792 }, .padding = .all(8) });
+            ui.text(c, task.title, .{ .size = 16, .color = .hex(if (task.done) 0x64748b else 0x0f172a) });
+            ui.end(c);
+            if (button(c, "Delete", .auto, 0xfee2e2)) remove = index;
+            ui.end(c);
+        }
+        ui.end(c);
+        ui.end(c);
+        var left: usize = 0;
+        for (s.rows.items) |task| {
+            if (!task.done) {
+                left += 1;
+            }
+        }
+        ui.row(c, .{ .height = .{ .px = 37.792 }, .gap = 12, .align_items = .center });
+        ui.textf(c, .{ .size = 14 }, "{d} left", .{left});
+        ui.row(c, .{ .gap = 6 });
+        inline for (.{ .{ "All", Filter.all }, .{ "Active", Filter.active }, .{ "Done", Filter.done } }) |pair| {
+            if (button(c, pair[0], .auto, if (s.filter == pair[1]) 0xc7d2fe else 0xe2e8f0)) {
+                s.filter = pair[1];
+                s.action(@tagName(pair[1]));
+            }
+        }
+        ui.end(c);
+        ui.end(c);
+        if (s.deleted) |deleted| {
+            ui.row(c, .{ .height = .{ .px = 37.792 }, .gap = 8, .align_items = .center });
+            ui.textf(c, .{ .size = 16 }, "Deleted {s}", .{deleted.task.title});
+            if (button(c, "Undo", .auto, 0xfef3c7)) {
+                s.rows.insert(s.gpa, @min(deleted.index, s.rows.items.len), deleted.task) catch @panic("undo task");
+                s.deleted = null;
+                s.action("undo");
+            }
+            ui.end(c);
+        }
+        ui.end(c);
+        if (toggle) |i| {
+            s.rows.items[i].done = !s.rows.items[i].done;
+            s.action("complete");
+        }
+        if (remove) |i| {
+            if (s.deleted) |old| s.gpa.free(old.task.title);
+            s.deleted = .{ .index = i, .task = s.rows.orderedRemove(i) };
+            s.action("delete");
+        }
+        s.marker(c);
+    }
+    fn marker(s: *Todos, c: *ui.Context) void {
+        const payload: u32 = @intCast((s.callbacks + s.ticks) & 0x7fff_ffff);
+        const encoded = payload | (@as(u32, @popCount(payload) & 1) << 31);
+        for (0..32) |bit| {
+            const shift: u5 = @intCast(bit);
+            _ = c.leaf(.{ .absolute = true, .fixed = true, .width = .{ .px = 5 }, .height = .{ .px = 5 }, .offset = .{ .x = 476 + @as(f32, @floatFromInt(bit % 8)) * 7, .y = 18 + @as(f32, @floatFromInt(bit / 8)) * 7 }, .background = .hex(if (((encoded >> shift) & 1) != 0) 0xffffff else 0x000000), .layer = 10 }, .none, null);
+        }
+    }
+    fn report(s: *Todos) void {
+        var done: usize = 0;
+        for (s.rows.items) |task| {
+            if (task.done) {
+                done += 1;
+            }
+        }
+        s.emit("TODO_MODEL", .{ .framework = "nanoui", .rows = s.rows.items.len, .done = done, .callbacks = s.callbacks, .actions = s.actions.items, .animation_ticks = s.ticks, .marker_revision = s.callbacks + s.ticks, .animation_skipped = s.skipped, .draft = s.draft.text(), .deleted = if (s.deleted) |d| @as(?u64, d.task.id) else null, .filter = @tagName(s.filter), .next_id = s.next_id, .first_task = if (s.rows.items.len > 0) @as(?Task, s.rows.items[0]) else null, .last_task = if (s.rows.items.len > 0) @as(?Task, s.rows.items[s.rows.items.len - 1]) else null });
+        s.emit("TODO_STATE", .{ .rows = s.rows.items, .filter = @tagName(s.filter), .next_id = s.next_id, .draft = s.draft.text(), .deleted = if (s.deleted) |d| @as(?u64, d.task.id) else null });
+        s.emit("TODO_FRAMES", .{ .framework = "nanoui", .boundary = "gtk-gl-draw-return-or-cairo-paint", .elapsed_ns = s.frames[0..s.frame_count], .observer_overflow = s.overflow });
+    }
+};
+pub fn main(init: std.process.Init) !void {
+    const env = init.environ_map;
+    const rows = if (env.get("TODO_BENCH_ROWS")) |raw| try std.fmt.parseInt(usize, raw, 10) else 0;
+    if (rows > 10000) return error.TooManyRows;
+    const app = try nanoui.App.create(init, .{ .name = "Todo comparison" });
+    defer app.destroy();
+    var s: Todos = .{ .gpa = init.gpa, .started = ui.clock.now(), .animate = std.mem.eql(u8, env.get("TODO_BENCH_ANIMATE") orelse "", "1") };
+    current = &s;
+    defer current = null;
+    defer s.report();
+    for (0..rows) |i| try s.rows.append(init.gpa, .{ .id = i, .title = try std.fmt.allocPrint(init.gpa, "Task {d:0>4}", .{i + 1}), .done = i % 3 == 1 });
+    s.next_id = rows;
+    var theme = ui.Theme.light;
+    theme.font = "Noto Sans";
+    theme.background = .hex(0xf8fafc);
+    theme.text = .hex(0x0f172a);
+    _ = try app.newWindow(.{ .title = "NanoUI Todo comparison", .width = 540, .height = 620, .theme = theme, .content = .{ .view = .init(&s, Todos.view) } });
+    try app.run();
+}
