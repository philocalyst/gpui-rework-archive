+//! Hidden host-presentation receipts for the cross-framework Todo benchmark.
+//! Enabled only by the adapter calling `begin`; timestamps are collected after
+//! `PresentationStatus::Presented` and emitted once after the window closes.
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+#[derive(Default)]
+struct Receipts {
+    started: Option<Instant>,
+    elapsed_ns: Vec<u64>,
+    renderer: Option<String>,
+    overflow: u64,
+}
+static RECEIPTS: OnceLock<Mutex<Receipts>> = OnceLock::new();
+fn receipts() -> &'static Mutex<Receipts> {
+    RECEIPTS.get_or_init(|| Mutex::new(Receipts::default()))
+}
+
+/// Start timing before application startup. No-op unless `TODO_BENCH_PRESENT_MARKER=1`.
+pub fn begin() {
+    if std::env::var_os("TODO_BENCH_PRESENT_MARKER").is_some() {
+        let mut r = receipts().lock().unwrap();
+        r.started = Some(Instant::now());
+        r.elapsed_ns.clear();
+        r.overflow = 0;
+    }
+}
+
+/// Record a successfully returned native host presentation.
+pub(crate) fn record_present(
+    name: &str,
+    backend: &str,
+    device_type: &str,
+    vendor: u32,
+    device: u32,
+) {
+    let Ok(mut r) = receipts().lock() else { return };
+    let Some(start) = r.started else { return };
+    let elapsed = start.elapsed().as_nanos().min(u64::MAX as u128) as u64;
+    if r.elapsed_ns.is_empty() {
+        r.renderer = Some(format!(
+            "wgpu:{backend}:{device_type}:{vendor:04x}:{device:04x}:{name}"
+        ));
+        eprintln!(
+            "TODO_RENDERER,{}",
+            r.renderer.as_deref().unwrap_or("unknown")
+        );
+        eprintln!("TODO_FIRST_PRESENT,{elapsed}");
+    }
+    if r.elapsed_ns.len() < 200_000 {
+        r.elapsed_ns.push(elapsed);
+    } else {
+        r.overflow += 1;
+    }
+}
+
+/// Emit buffered host receipts once, when the benchmark window closes.
+pub fn finish() {
+    let Ok(r) = receipts().lock() else { return };
+    if r.started.is_none() {
+        return;
+    }
+    eprintln!(
+        "TODO_FRAMES,{{\"framework\":\"zgui\",\"boundary\":\"wgpu_surface_present_return\",\"elapsed_ns\":{:?},\"observer_overflow\":{}}}",
+        r.elapsed_ns, r.overflow
+    );
+}
+
+/// Successful first-presentation epoch used by the benchmark animation scheduler.
+pub fn first_present_time() -> Option<Instant> {
+    let r = receipts().lock().ok()?;
+    Some(r.started? + Duration::from_nanos(*r.elapsed_ns.first()?))
+}
