diff --git a/crates/zgui-desktop/examples/todos.rs b/crates/zgui-desktop/examples/todos.rs
new file mode 100644
index 0000000..cbded27
--- /dev/null
+++ b/crates/zgui-desktop/examples/todos.rs
@@ -0,0 +1,526 @@
+//! Native Todo port used for the GPUI comparison.
+//!
+//! The default launch is an empty 540x620 application. Benchmark-only
+//! `TODO_BENCH_*` variables seed comparison rows and enable a display-paced
+//! animation. Todo rows remain ordinary retained children; they are not
+//! virtualized.
+
+use std::{
+    hash::{Hash, Hasher},
+    time::Instant,
+};
+use zgui::{compose::prelude::*, reactive::Signal};
+use zgui_desktop::{Application, WindowOptions};
+
+#[derive(Clone, Copy, Default, PartialEq, Eq)]
+enum Filter {
+    #[default]
+    All,
+    Active,
+    Done,
+}
+
+#[derive(Clone, PartialEq, Eq)]
+struct Todo {
+    id: u64,
+    title: String,
+    done: bool,
+}
+
+/// A keyed row carries its state handle, so mounting 10,000 rows is linear.
+#[derive(Clone)]
+struct TodoRow {
+    id: u64,
+    todo: Signal<Todo>,
+}
+impl PartialEq for TodoRow {
+    fn eq(&self, other: &Self) -> bool {
+        self.id == other.id
+    }
+}
+impl Eq for TodoRow {}
+impl Hash for TodoRow {
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        self.id.hash(state);
+    }
+}
+
+#[derive(Clone, PartialEq, Eq)]
+struct Deleted {
+    index: usize,
+    todo: TodoRow,
+}
+
+#[derive(Clone)]
+struct AppState {
+    draft: Signal<String>,
+    filter: Signal<Filter>,
+    todos: Signal<Vec<TodoRow>>,
+    next_id: Signal<u64>,
+    deleted: Signal<Option<Deleted>>,
+}
+
+fn add(
+    draft: &Signal<String>,
+    todos: &Signal<Vec<TodoRow>>,
+    next_id: &Signal<u64>,
+    runtime: &zgui::reactive::Runtime,
+) {
+    let title = draft.get().trim().to_owned();
+    if title.is_empty() {
+        return;
+    }
+    let id = next_id.get();
+    let Some(next) = id.checked_add(1) else {
+        return;
+    };
+    draft.set(String::new());
+    let todo = runtime.signal(Todo {
+        id,
+        title,
+        done: false,
+    });
+    todos.update(|items| items.push(TodoRow { id, todo }));
+    next_id.set(next);
+}
+
+fn todo_row(
+    todo: Signal<Todo>,
+    todos: Signal<Vec<TodoRow>>,
+    deleted: Signal<Option<Deleted>>,
+    actions: Signal<u64>,
+) -> View {
+    let id = todo.with(|item| item.id);
+    let title_signal = todo.clone();
+    let title = text_signal(move || title_signal.with(|item| item.title.clone()));
+    let completion_signal = todo.clone();
+    let complete = button()
+        .id(format!("todo-complete-{id}"))
+        .child(text_signal(move || {
+            if completion_signal.with(|item| item.done) {
+                "Reopen".to_owned()
+            } else {
+                "Complete".to_owned()
+            }
+        }))
+        .w(100.)
+        .p(8.)
+        .rounded(0.)
+        .bg(rgb(0xe2e8f0))
+        .on_click({
+            let todo = todo.clone();
+            let actions = actions.clone();
+            move || {
+                actions.update(|count| *count += 1);
+                todo.update(|item| item.done = !item.done);
+            }
+        });
+    let done_text = todo.clone();
+    let title = div().w(220.).p(8.).child(title).reactive_style(move || {
+        if done_text.with(|item| item.done) {
+            Styles::new().text_color(rgb(0x64748b))
+        } else {
+            Styles::new().text_color(rgb(0x0f172a))
+        }
+    });
+    let delete = button()
+        .id(format!("todo-delete-{id}"))
+        .child(text("Delete"))
+        .p(8.)
+        .rounded(0.)
+        .bg(rgb(0xfee2e2))
+        .on_click(move || {
+            actions.update(|count| *count += 1);
+            todos.update(|items| {
+                if let Some(index) = items.iter().position(|row| row.id == id) {
+                    deleted.set(Some(Deleted {
+                        index,
+                        todo: items.remove(index),
+                    }));
+                }
+            });
+        });
+    row()
+        .id(format!("todo-row-{id}"))
+        .gap(8.)
+        .items_center()
+        .child(complete)
+        .child(title)
+        .child(delete)
+}
+
+fn filter_button(
+    label: &'static str,
+    filter_value: Filter,
+    filter: Signal<Filter>,
+    actions: Signal<u64>,
+) -> View {
+    let selected = filter.clone();
+    button()
+        .id(match filter_value {
+            Filter::All => "todo-filter-all",
+            Filter::Active => "todo-filter-active",
+            Filter::Done => "todo-filter-done",
+        })
+        .child(text(label))
+        .p(8.)
+        .rounded(0.)
+        .reactive_style(move || {
+            Styles::new().bg(if selected.get() == filter_value {
+                rgb(0xc7d2fe)
+            } else {
+                rgb(0xe2e8f0)
+            })
+        })
+        .on_click(move || {
+            actions.update(|count| *count += 1);
+            filter.set(filter_value);
+        })
+}
+
+fn app(
+    state: AppState,
+    animate: bool,
+    tick_hz: f64,
+    actions: Signal<u64>,
+    animation_ticks: Signal<u64>,
+    animation_skipped: Signal<u64>,
+) -> View {
+    component(move |cx| {
+        let draft = state.draft.clone();
+        let filter = state.filter.clone();
+        let todos = state.todos.clone();
+        let next_id = state.next_id.clone();
+        let deleted = state.deleted.clone();
+        let animation_offset = cx.state(0.0_f32);
+        let completion_line = text_signal({
+            let todos = todos.clone();
+            move || {
+                let left = todos.with(|items| {
+                    items
+                        .iter()
+                        .filter(|row| row.todo.with(|item| !item.done))
+                        .count()
+                });
+                format!("{left} left")
+            }
+        })
+        .text_size(14.)
+        .line_height(19.068);
+
+        let add_button = button()
+            .id("todo-add")
+            .child(text("Add"))
+            .p(10.)
+            .w(56.)
+            .rounded(0.)
+            .bg(rgb(0xc7d2fe))
+            .on_click({
+                let draft = draft.clone();
+                let todos = todos.clone();
+                let next_id = next_id.clone();
+                let actions = actions.clone();
+                let runtime = cx.runtime();
+                move || {
+                    actions.update(|count| *count += 1);
+                    add(&draft, &todos, &next_id, &runtime);
+                }
+            });
+        let all_button = filter_button("All", Filter::All, filter.clone(), actions.clone());
+        let active_button =
+            filter_button("Active", Filter::Active, filter.clone(), actions.clone());
+        let done_button = filter_button("Done", Filter::Done, filter.clone(), actions.clone());
+
+        let rows_for_keys = todos.clone();
+        let filter_for_keys = filter.clone();
+        let list_rows = keyed(
+            move || {
+                let selected = filter_for_keys.get();
+                rows_for_keys.with(|items| {
+                    items
+                        .iter()
+                        .filter(|row| match selected {
+                            Filter::All => true,
+                            Filter::Active => row.todo.with(|item| !item.done),
+                            Filter::Done => row.todo.with(|item| item.done),
+                        })
+                        .cloned()
+                        .collect::<Vec<_>>()
+                })
+            },
+            {
+                let todos = todos.clone();
+                let deleted = deleted.clone();
+                let actions = actions.clone();
+                move |key: TodoRow, _: &mut zgui::compose::Context| {
+                    todo_row(key.todo, todos.clone(), deleted.clone(), actions.clone())
+                }
+            },
+        )
+        .gap(6.);
+        let list_offset = cx.state(0.0_f32);
+        let list_content = column()
+            .w_full()
+            .reactive_style({
+                let animation_offset = animation_offset.clone();
+                move || Styles::new().translate(0., animation_offset.get())
+            })
+            .child(list_rows);
+        let list = scroll(list_offset)
+            .id("todo-list")
+            .w_full()
+            .h(360.)
+            .scrollbar(false)
+            .child(list_content);
+
+        let view = column()
+            .w_full()
+            .h_full()
+            .p(24.)
+            .gap(12.)
+            .bg(rgb(0xffffff))
+            .text_color(rgb(0x0f172a))
+            .text_size(16.)
+            .line_height(21.792)
+            .font_family("Noto Sans")
+            .font_fallbacks([
+                zgui::text_layout::FontFamily::Named("Noto Sans Arabic".into()),
+                zgui::text_layout::FontFamily::Named("Noto Sans Hebrew".into()),
+            ])
+            .child(
+                text("Todos")
+                    .text_size(28.)
+                    .line_height(38.136)
+                    .text_color(rgb(0x172554))
+                    .h(38.136),
+            )
+            .child(
+                row()
+                    .w_full()
+                    .gap(8.)
+                    .items_center()
+                    .child(
+                        text_input("New task", draft.clone())
+                            .id("todo-input")
+                            .w(280.)
+                            .h(41.792)
+                            .p(10.)
+                            .rounded(0.)
+                            .bg(rgb(0xf1f5f9)),
+                    )
+                    .child(add_button),
+            )
+            .child(list)
+            .child(
+                row().gap(12.).items_center().child(completion_line).child(
+                    row()
+                        .gap(6.)
+                        .items_center()
+                        .child(all_button)
+                        .child(active_button)
+                        .child(done_button),
+                ),
+            )
+            .child_when(
+                {
+                    let deleted = deleted.clone();
+                    move || deleted.get().map(|entry| entry.todo.id)
+                },
+                {
+                    let deleted = deleted.clone();
+                    let todos = todos.clone();
+                    let actions = actions.clone();
+                    move |_, _: &mut zgui::compose::Context| {
+                        let deleted_line = text_signal({
+                            let deleted = deleted.clone();
+                            move || {
+                                deleted.get().map_or_else(String::new, |entry| {
+                                    let title = entry.todo.todo.with(|todo| todo.title.clone());
+                                    format!("Deleted {title}")
+                                })
+                            }
+                        });
+                        let undo = button()
+                            .id("todo-undo")
+                            .child(text("Undo"))
+                            .p(8.)
+                            .rounded(0.)
+                            .bg(rgb(0xfef3c7))
+                            .on_click({
+                                let todos = todos.clone();
+                                let deleted = deleted.clone();
+                                let actions = actions.clone();
+                                move || {
+                                    actions.update(|count| *count += 1);
+                                    if let Some(previous) = deleted.get() {
+                                        todos.update(|items| {
+                                            items.insert(
+                                                previous.index.min(items.len()),
+                                                previous.todo.clone(),
+                                            );
+                                        });
+                                        deleted.set(None);
+                                    }
+                                }
+                            });
+                        row().gap(8.).items_center().child(deleted_line).child(undo)
+                    }
+                },
+            );
+
+        if animate {
+            let frames = cx.frames();
+            let offset = animation_offset.clone();
+            let ticks = animation_ticks.clone();
+            let skipped = animation_skipped.clone();
+            cx.tasks().spawn(async move {
+                let epoch = Instant::now();
+                let mut next_sample = 1_u64;
+                loop {
+                    frames.next().max_rate(tick_hz).await;
+                    let due = (epoch.elapsed().as_secs_f64() * tick_hz).floor() as u64;
+                    if due >= next_sample {
+                        skipped.update(|count| *count += due - next_sample);
+                        let phase = due as f32 / tick_hz as f32 * std::f32::consts::TAU;
+                        offset.set(12. * phase.sin());
+                        ticks.update(|count| *count += 1);
+                        next_sample = due + 1;
+                    }
+                }
+            });
+        }
+        view
+    })
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let mode = std::env::var("TODO_BENCH_MODE").unwrap_or_else(|_| "idle".to_owned());
+    let default_rows = match mode.as_str() {
+        "heavy" => 10_000,
+        "animation" => 1_000,
+        _ => 0,
+    };
+    let rows = std::env::var("TODO_BENCH_ROWS")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(default_rows);
+    let animate =
+        std::env::var("TODO_BENCH_ANIMATE").is_ok_and(|value| value == "1") || mode == "animation";
+    let tick_hz = std::env::var("TODO_BENCH_TICK_HZ")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(60.);
+    let duration = std::env::var("TODO_BENCH_SECONDS")
+        .ok()
+        .and_then(|value| value.parse().ok())
+        .unwrap_or(0.);
+    let font =
+        |bytes: &'static [u8]| zgui_desktop::FontData::new(bytes).expect("valid bundled Noto font");
+    Application::new()
+        .font(font(include_bytes!("support/todo_fonts/NotoSans.ttf")))
+        .font(font(include_bytes!(
+            "support/todo_fonts/NotoSansArabic-Regular.ttf"
+        )))
+        .font(font(include_bytes!(
+            "support/todo_fonts/NotoSansHebrew-Regular.ttf"
+        )))
+        .window(WindowOptions {
+            title: "Todos".into(),
+            width: 540.,
+            height: 620.,
+            max_frame_rate: animate.then_some(tick_hz),
+            ..Default::default()
+        })
+        .run(move |cx| {
+            let actions = cx.ui.signal(0_u64);
+            let animation_ticks = cx.ui.signal(0_u64);
+            let animation_skipped = cx.ui.signal(0_u64);
+            let state = AppState {
+                draft: cx.ui.signal(String::new()),
+                filter: cx.ui.signal(Filter::All),
+                todos: cx.ui.signal(
+                    (0..rows)
+                        .map(|index| {
+                            let todo = cx.ui.signal(Todo {
+                                id: index as u64,
+                                title: format!("Task {:04}", index + 1),
+                                done: index % 3 == 1,
+                            });
+                            TodoRow {
+                                id: index as u64,
+                                todo,
+                            }
+                        })
+                        .collect::<Vec<_>>(),
+                ),
+                next_id: cx.ui.signal(rows as u64),
+                deleted: cx.ui.signal(None::<Deleted>),
+            };
+            eprintln!(
+                "TODO_BENCH_CONFIG mode={mode} rows={rows} animation={animate} tick_hz={tick_hz}"
+            );
+            cx.render(app(
+                state.clone(),
+                animate,
+                tick_hz,
+                actions.clone(),
+                animation_ticks.clone(),
+                animation_skipped.clone(),
+            ));
+            if duration > 0. {
+                let window = cx.window.clone();
+                cx.tasks.spawn(async move {
+                    let started = Instant::now();
+                    zgui::timer::sleep(std::time::Duration::from_secs_f64(duration)).await;
+                    eprintln!(
+                        "TODO_BENCH_CLOSED elapsed_s={:.3}",
+                        started.elapsed().as_secs_f64()
+                    );
+                    window.close();
+                });
+            }
+            cx.on_closed(move || {
+                let items = state.todos.get();
+                let row_count = items.len();
+                let done = items
+                    .iter()
+                    .filter(|todo| todo.todo.with(|item| item.done))
+                    .count();
+                let draft = state.draft.get();
+                let deleted = state.deleted.get().map(|entry| entry.todo.id);
+                let first_task = items.first().map(|entry| {
+                    entry.todo.with(|todo| {
+                        serde_json::json!({"id": todo.id, "title": &todo.title, "done": todo.done})
+                    })
+                });
+                let last_task = items.last().map(|entry| {
+                    entry.todo.with(|todo| {
+                        serde_json::json!({"id": todo.id, "title": &todo.title, "done": todo.done})
+                    })
+                });
+                let filter = match state.filter.get() {
+                    Filter::All => "all",
+                    Filter::Active => "active",
+                    Filter::Done => "done",
+                };
+                eprintln!(
+                    "TODO_MODEL,{}",
+                    serde_json::json!({
+                        "framework": "zgui",
+                        "rows": row_count,
+                        "done": done,
+                        "filter": filter,
+                        "next_id": state.next_id.get(),
+                        "first_task": first_task,
+                        "last_task": last_task,
+                        "callbacks": actions.get(),
+                        "animation_ticks": animation_ticks.get(),
+                        "animation_skipped": animation_skipped.get(),
+                        "draft": draft,
+                        "deleted": deleted,
+                    })
+                );
+            });
+        })?;
+    Ok(())
+}
