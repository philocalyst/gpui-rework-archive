+
+#[test]
+fn public_prepare_and_play_command_cannot_turn_a_pure_owner_prepare_into_playback() {
+    let (worker, audio, capture, _, mut win) = owner();
+    let selection = hummingbird_gpui_port::worker::Selection {
+        id: Some(44),
+        sequence: 1,
+        generation: 0,
+    };
+    worker.handle().prepare_and_play(selection).unwrap();
+    worker
+        .checkpoint()
+        .unwrap()
+        .recv_timeout(Duration::from_secs(10))
+        .unwrap();
+    win.update(|model| model.prepare(44, 0)).unwrap();
+    settle(&mut win, &worker).unwrap();
+    assert_eq!(win.with_model(|model| *model.selected).unwrap(), selection);
+    assert_eq!(
+        win.with_model(|model| model.prepared().unwrap().1.track_id)
+            .unwrap(),
+        Some(44)
+    );
+    assert!(
+        win.with_model(|model| model.queue.playback().queue().is_empty())
+            .unwrap()
+    );
+    assert!(capture.lock().unwrap().streams.is_empty());
+    close(win, audio, worker);
+}
diff --git a/reactivity/ports/hummingbird/tests/preparation_authority.rs b/reactivity/ports/hummingbird/tests/preparation_authority.rs
new file mode 100644
index 0000000000..7b4c4a674a
--- /dev/null
+++ b/reactivity/ports/hummingbird/tests/preparation_authority.rs
@@ -0,0 +1,51 @@
+use gpui::{Win, WindowOptions};
+use hummingbird_gpui_port::{
+    app::{Library, connect},
+    database::Database,
+    worker::{Selection, Worker},
+};
+use std::time::Duration;
+fn reject_prequeued(selection: Selection) {
+    let (worker, inbox) = Worker::new(Database::fixture().unwrap()).unwrap();
+    let (model, questions) = connect(worker.handle()).unwrap();
+    let mut owner = Win::with_questions(model, questions, WindowOptions::default())
+        .unwrap()
+        .with_inbox_status(inbox, Library::receive)
+        .unwrap();
+    worker.handle().prepare(selection).unwrap();
+    worker
+        .checkpoint()
+        .unwrap()
+        .recv_timeout(Duration::from_secs(10))
+        .unwrap();
+    owner.update(|model| model.prepare(44, 0)).unwrap();
+    worker
+        .checkpoint()
+        .unwrap()
+        .recv_timeout(Duration::from_secs(10))
+        .unwrap();
+    owner.deliver_ready(32).unwrap();
+    let prepared = owner
+        .with_model(|model| model.prepared().unwrap().1.track_id)
+        .unwrap();
+    drop(owner);
+    worker.finish().unwrap();
+    assert_eq!(prepared, Some(44));
+}
+
+#[test]
+fn prequeued_public_request_cannot_claim_library_issued_authority() {
+    reject_prequeued(Selection {
+        id: Some(90),
+        sequence: 1,
+        generation: 0,
+    });
+}
+#[test]
+fn prequeued_wrong_generation_cannot_fail_a_current_request_with_the_same_sequence() {
+    reject_prequeued(Selection {
+        id: Some(44),
+        sequence: 1,
+        generation: 1,
+    });
+}
