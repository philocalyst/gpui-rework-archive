diff --git a/reactivity/ports/hummingbird/src/browser.rs b/reactivity/ports/hummingbird/src/browser.rs
new file mode 100644
index 0000000000..4bbc1420b9
--- /dev/null
+++ b/reactivity/ports/hummingbird/src/browser.rs
@@ -0,0 +1,405 @@
+//! One collection browser state and one pure worker input; no page entities.
+use crate::{
+    app::Library,
+    search::{SearchInput, Sort, SourceError, Version},
+};
+use gpui::prelude::*;
+use triomphe::Arc;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Route {
+    #[default]
+    Tracks,
+    Albums,
+    Artists,
+    Playlists,
+    Album(i64),
+    Artist(i64),
+    Playlist(i64),
+}
+impl Route {
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::Tracks => "Tracks",
+            Self::Albums => "Albums",
+            Self::Artists => "Artists",
+            Self::Playlists => "Playlists",
+            Self::Album(_) => "Album",
+            Self::Artist(_) => "Artist",
+            Self::Playlist(_) => "Playlist",
+        }
+    }
+}
+/// The private domain counter is never restored from navigation history.
+/// Both list domains are replaced before changing to unrelated items.
+#[derive(Debug)]
+pub struct Navigation {
+    history: Vec<Route>,
+    cursor: usize,
+    domain: u64,
+    exhausted: bool,
+}
+impl Navigation {
+    fn new() -> Self {
+        Self {
+            history: vec![Route::Tracks],
+            cursor: 0,
+            domain: 1,
+            exhausted: false,
+        }
+    }
+    pub fn current(&self) -> Route {
+        self.history[self.cursor]
+    }
+    pub fn len(&self) -> usize {
+        self.history.len()
+    }
+    pub fn is_empty(&self) -> bool {
+        self.history.is_empty()
+    }
+    pub fn can_back(&self) -> bool {
+        self.cursor != 0
+    }
+    pub fn can_forward(&self) -> bool {
+        self.cursor + 1 < self.history.len()
+    }
+    fn renew(&mut self) -> bool {
+        if let Some(next) = self.domain.checked_add(2).filter(|n| *n < u64::MAX) {
+            self.domain = next;
+            true
+        } else {
+            self.exhausted = true;
+            false
+        }
+    }
+    pub fn navigate(&mut self, route: Route) {
+        if !self.renew() {
+            return;
+        }
+        self.history.truncate(self.cursor + 1);
+        if self.history.len() == 100 {
+            self.history.remove(0);
+        }
+        self.history.push(route);
+        self.cursor = self.history.len() - 1;
+    }
+    pub fn back(&mut self) {
+        if self.can_back() && self.renew() {
+            self.cursor -= 1;
+        }
+    }
+    pub fn forward(&mut self) {
+        if self.can_forward() && self.renew() {
+            self.cursor += 1;
+        }
+    }
+    pub fn refresh(&mut self) {
+        self.renew();
+    }
+    pub fn track_list(&self) -> ListId {
+        ListId::new(self.domain)
+    }
+}
+#[derive(Debug)]
+pub struct Browser {
+    navigation: Signal<Navigation>,
+    query: Signal<String>,
+    sort: Signal<Sort>,
+}
+impl Browser {
+    pub const NAV: Source<Self, Navigation> = Source::new(
+        FieldId::new(1),
+        "navigation",
+        |m| &m.navigation,
+        |m| &mut m.navigation,
+    );
+    pub const QUERY: Source<Self, String> =
+        Source::new(FieldId::new(2), "search", |m| &m.query, |m| &mut m.query);
+    pub const SORT: Source<Self, Sort> =
+        Source::new(FieldId::new(3), "sort", |m| &m.sort, |m| &mut m.sort);
+    pub(crate) fn new() -> Self {
+        Self {
+            navigation: Signal::new(Navigation::new()),
+            query: Signal::new(String::new()),
+            sort: Signal::new(Sort::Title),
+        }
+    }
+    pub fn navigation(&self) -> &Navigation {
+        &self.navigation
+    }
+    pub fn revisions(&self) -> [u32; 3] {
+        [
+            self.navigation.revision().get(),
+            self.query.revision().get(),
+            self.sort.revision().get(),
+        ]
+    }
+    pub fn matches(&self, input: &Input, version: Version) -> bool {
+        self.navigation.current() == input.route
+            && self.navigation.domain == input.domain
+            && *self.query == input.search.query
+            && *self.sort == input.search.sort
+            && version == input.search.version
+    }
+    pub(crate) fn navigate(&mut self, route: Route) {
+        self.navigation.navigate(route);
+    }
+    pub(crate) fn source_changed(&mut self) {
+        self.navigation.refresh();
+    }
+}
+impl View for Browser {
+    fn sources() -> Sources<Self> {
+        Sources::new()
+            .field(Self::NAV)
+            .direct(Self::QUERY)
+            .field(Self::SORT)
+    }
+    fn view(&self) -> El<'_> {
+        column((
+            row((
+                button("Tracks").on_click(Self::NAV.update(|nav| nav.navigate(Route::Tracks))),
+                button("Albums").on_click(Self::NAV.update(|nav| nav.navigate(Route::Albums))),
+                button("Artists").on_click(Self::NAV.update(|nav| nav.navigate(Route::Artists))),
+                button("Playlists")
+                    .on_click(Self::NAV.update(|nav| nav.navigate(Route::Playlists))),
+                button("Back").on_click(Self::NAV.update(Navigation::back)),
+                button("Forward").on_click(Self::NAV.update(Navigation::forward)),
+                button("Refresh").on_click(Self::NAV.update(Navigation::refresh)),
+            ))
+            .gap(8),
+            text_input(&self.query)
+                .name("Search recordings")
+                .description("Search this collection")
+                .w(650)
+                .h(32),
+            if matches!(
+                self.navigation.current(),
+                Route::Albums | Route::Artists | Route::Playlists
+            ) {
+                text(match self.navigation.current() {
+                    Route::Albums => "Album title order",
+                    Route::Artists => "Artist name order",
+                    _ => "Playlist order",
+                })
+            } else {
+                row((
+                    button(match self.navigation.current() {
+                        Route::Album(_) => "Track order",
+                        Route::Playlist(_) => "Playlist order",
+                        _ => "Title",
+                    })
+                    .on_click(Self::SORT.update(|sort| *sort = Sort::Title)),
+                    button("Artist").on_click(Self::SORT.update(|sort| *sort = Sort::Artist)),
+                    button("Longest first")
+                        .on_click(Self::SORT.update(|sort| *sort = Sort::Longest)),
+                ))
+                .gap(8)
+            },
+            text(if self.navigation.exhausted {
+                "Navigation identity space exhausted"
+            } else {
+                ""
+            }),
+        ))
+        .gap(8)
+    }
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Input {
+    pub route: Route,
+    pub(crate) domain: u64,
+    pub search: SearchInput,
+}
+impl Input {
+    pub fn sort_label(&self) -> &'static str {
+        match (self.route, self.sort) {
+            (Route::Album(_), Sort::Title) => "Track order",
+            (Route::Playlist(_), Sort::Title) => "Playlist order",
+            _ => self.sort.label(),
+        }
+    }
+    pub fn freeze(
+        navigation: &Navigation,
+        query: &str,
+        sort: Sort,
+        version: Version,
+    ) -> Result<Arc<Self>, SourceError> {
+        Ok(Arc::new(Self {
+            route: navigation.current(),
+            domain: navigation.domain,
+            search: SearchInput::freeze(query, sort, version)?,
+        }))
+    }
+}
+impl std::ops::Deref for Input {
+    type Target = SearchInput;
+    fn deref(&self) -> &SearchInput {
+        &self.search
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum RowKey {
+    Track(i64),
+    PlaylistItem { item: i64, track: i64 },
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PlayRequest {
+    pub input: Arc<Input>,
+    pub start: Option<RowKey>,
+    pub sequence: u64,
+}
+#[derive(Debug)]
+pub struct PreparedListing {
+    pub tracks: Vec<crate::queue::TrackRef>,
+    pub start: usize,
+}
+#[derive(Debug)]
+pub struct CollectionRow {
+    pub route: Route,
+    pub id: i64,
+    pub title: String,
+    pub detail: String,
+}
+pub struct TrackRows {
+    pub input: Arc<Input>,
+    pub rows: Vec<crate::query::TrackSearchRow>,
+    /// Playlist item identity is separate from recording identity. Ordinary
+    /// track pages do not allocate this lane.
+    pub playlist_items: Vec<i64>,
+}
+impl TrackRows {
+    pub fn len(&self) -> usize {
+        self.rows.len()
+    }
+    pub fn is_empty(&self) -> bool {
+        self.rows.is_empty()
+    }
+    pub fn identity(&self, index: usize) -> RowKey {
+        let track = self.rows[index].id;
+        self.playlist_items
+            .get(index)
+            .map_or(RowKey::Track(track), |item| RowKey::PlaylistItem {
+                item: *item,
+                track,
+            })
+    }
+}
+pub struct Collections {
+    pub input: Arc<Input>,
+    pub rows: Vec<CollectionRow>,
+}
+pub struct Page {
+    pub title: String,
+    pub rows: TrackRows,
+    pub collections: Collections,
+}
+impl Page {
+    pub fn input(&self) -> &Arc<Input> {
+        &self.rows.input
+    }
+    pub fn ids(&self) -> impl Iterator<Item = i64> + '_ {
+        self.rows.rows.iter().map(|row| row.id)
+    }
+    pub fn track_list(&self) -> ListId {
+        ListId::new(self.input().domain)
+    }
+    pub fn collection_list(&self) -> ListId {
+        ListId::new(self.input().domain + 1)
+    }
+}
+impl ItemSource for TrackRows {
+    fn len(&self) -> usize {
+        self.len()
+    }
+    fn key(&self, index: usize) -> ItemKey {
+        ItemKey::new(match self.identity(index) {
+            RowKey::Track(id) => id,
+            RowKey::PlaylistItem { item, .. } => item,
+        } as u64)
+    }
+    fn index_of(&self, key: ItemKey) -> Option<usize> {
+        (0..self.len()).find(|i| self.key(*i) == key)
+    }
+    fn row(&self, index: usize) -> El<'_> {
+        let track = &self.rows[index];
+        let id = track.id;
+        let generation = self.input.version.generation;
+        #[cfg(feature = "audio")]
+        let context = self.input.clone();
+        #[cfg(feature = "audio")]
+        let key = self.identity(index);
+        #[cfg(feature = "audio")]
+        let play = button("Play now")
+            .name(format!("Play {} now", track.title))
+            .w(76)
+            .h(32)
+            .on_click(move |model: &mut Library| model.play_now(id, generation));
+        #[cfg(not(feature = "audio"))]
+        let play = text("");
+        #[cfg(feature = "audio")]
+        let from = button("Play from here")
+            .name(format!("Play from {}", track.title))
+            .on_click(move |model: &mut Library| model.play_listing(context.clone(), Some(key)));
+        #[cfg(not(feature = "audio"))]
+        let from = text("");
+        row((
+            button("Prepare")
+                .name(format!("Prepare {}", track.title))
+                .w(64)
+                .h(32)
+                .on_click(move |model: &mut Library| model.prepare(id, generation)),
+            play,
+            text(track.title.as_str()).w(180).p(6),
+            text(track.artist_names.as_deref().unwrap_or("Unknown artist"))
+                .w(120)
+                .p(6),
+            from,
+        ))
+        .h(32)
+        .bg(if index.is_multiple_of(2) {
+            rgb(0xf1f5f9)
+        } else {
+            Color::WHITE
+        })
+    }
+}
+impl ItemSource for Collections {
+    fn len(&self) -> usize {
+        self.rows.len()
+    }
+    fn key(&self, index: usize) -> ItemKey {
+        ItemKey::new(self.rows[index].id as u64)
+    }
+    fn index_of(&self, key: ItemKey) -> Option<usize> {
+        self.rows.iter().position(|row| row.id as u64 == key.get())
+    }
+    fn row(&self, index: usize) -> El<'_> {
+        let item = &self.rows[index];
+        let route = item.route;
+        let input = self.input.clone();
+        row((
+            button(format!("Open {}", item.title))
+                .w(260)
+                .on_click(move |model: &mut Library| model.open_collection(&input, route)),
+            text(item.detail.as_str()).w(330),
+        ))
+        .h(32)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn navigation_domain_exhaustion_keeps_current_route_and_never_reuses_a_new_identity() {
+        let mut navigation = Navigation::new();
+        navigation.domain = u64::MAX - 2;
+        let old = navigation.track_list();
+        navigation.navigate(Route::Albums);
+        assert!(navigation.exhausted);
+        assert_eq!(navigation.current(), Route::Tracks);
+        assert_eq!(navigation.track_list(), old);
+        assert_eq!(navigation.len(), 1);
+    }
+}
diff --git a/reactivity/ports/hummingbird/src/collection_query.rs b/reactivity/ports/hummingbird/src/collection_query.rs
new file mode 100644
index 0000000000..fda4e00d1c
--- /dev/null
+++ b/reactivity/ports/hummingbird/src/collection_query.rs
@@ -0,0 +1,272 @@
+//! Display projections adapted from upstream album/artist/playlist SQL. The
+//! existing TrackQuery supplies credited-artist UNION and release ordering.
+use crate::{
+    browser::{
+        CollectionRow, Collections, Input, Page, PlayRequest, PreparedListing, Route, TrackRows,
+    },
+    database::Database,
+    query::{TrackColumn, TrackQuery, TrackSearchRow, tracks},
+    search::{Searcher, Sort, SourceError},
+};
+use nucleo_matcher::pattern::{CaseMatching, Normalization, Pattern};
+use rusqlite::types::Value;
+use triomphe::Arc;
+
+pub(crate) fn page(
+    database: &Database,
+    searcher: &mut Searcher,
+    input: Arc<Input>,
+    cancelled: impl FnMut() -> bool,
+) -> Option<Result<Page, SourceError>> {
+    let _snapshot = match database.connection().unchecked_transaction() {
+        Ok(snapshot) => snapshot,
+        Err(error) => return Some(Err(error.into())),
+    };
+    read_page(database, searcher, input, cancelled)
+}
+fn read_page(
+    database: &Database,
+    searcher: &mut Searcher,
+    input: Arc<Input>,
+    mut cancelled: impl FnMut() -> bool,
+) -> Option<Result<Page, SourceError>> {
+    if input.query.len() > crate::search::MAX_QUERY_BYTES {
+        return Some(Err(SourceError::QueryTooLong));
+    }
+    if cancelled() {
+        return None;
+    }
+    let result = (|| {
+        let connection = database.connection();
+        let title = match input.route {
+            Route::Album(id) => connection
+                .query_row("SELECT title FROM album WHERE id=?", [id], |row| row.get(0))
+                .optional()?,
+            Route::Artist(id) => connection
+                .query_row("SELECT name FROM artist WHERE id=?", [id], |row| row.get(0))
+                .optional()?,
+            Route::Playlist(id) => connection
+                .query_row("SELECT name FROM playlist WHERE id=?", [id], |row| {
+                    row.get(0)
+                })
+                .optional()?,
+            route => Some(route.label().to_owned()),
+        }
+        .ok_or(SourceError::MissingCollection)?;
+        let Some(rows) = read_tracks(database, searcher, input.clone(), &mut cancelled) else {
+            return Ok(None);
+        };
+        let rows = rows?;
+        let mut collections = Collections {
+            input: input.clone(),
+            rows: Vec::new(),
+        };
+        let collection_query = match input.route {
+            Route::Albums | Route::Artist(_) => Some((
+                "SELECT album.id,album.title,COALESCE(NULLIF(album.artist_display_override,''),(SELECT GROUP_CONCAT(artist.name, ', ') FROM album_artist JOIN artist ON artist.id=album_artist.artist_id WHERE album_artist.album_id=album.id),'Unknown artist') FROM album",
+                "album.title_sortable COLLATE NOCASE ASC,album.id ASC",
+                0,
+            )),
+            Route::Artists => Some((
+                "SELECT artist.id,artist.name,CAST((SELECT COUNT(*) FROM album_artist WHERE album_artist.artist_id=artist.id) AS TEXT)||' albums' FROM artist WHERE EXISTS(SELECT 1 FROM album_artist WHERE album_artist.artist_id=artist.id) OR EXISTS(SELECT 1 FROM track_artist WHERE track_artist.artist_id=artist.id)",
+                "artist.name_sortable COLLATE NOCASE ASC,artist.id ASC",
+                1,
+            )),
+            Route::Playlists => Some((
+                "SELECT playlist.id,playlist.name,CAST(COUNT(playlist_item.id) AS TEXT)||' tracks' FROM playlist LEFT JOIN playlist_item ON playlist_item.playlist_id=playlist.id",
+                "playlist.position ASC,playlist.id ASC",
+                2,
+            )),
+            _ => None,
+        };
+        if let Some((sql, order, kind)) = collection_query {
+            let mut sql = sql.to_owned();
+            let mut values = Vec::<Value>::new();
+            if let Route::Artist(id) = input.route {
+                sql.push_str(" WHERE EXISTS(SELECT 1 FROM album_artist WHERE album_artist.album_id=album.id AND album_artist.artist_id=?)");
+                values.push(id.into());
+            }
+            if kind == 2 {
+                sql.push_str(" GROUP BY playlist.id");
+            }
+            sql.push_str(" ORDER BY ");
+            sql.push_str(order);
+            let pattern = Pattern::parse(&input.query, CaseMatching::Smart, Normalization::Smart);
+            let mut statement = connection.prepare(&sql)?;
+            let mut cursor = statement.query(rusqlite::params_from_iter(values))?;
+            while let Some(row) = cursor.next()? {
+                if cancelled() {
+                    return Ok(None);
+                }
+                let title = row.get_ref(1)?.as_str().map_err(text_error)?;
+                let detail = row.get_ref(2)?.as_str().map_err(text_error)?;
+                if searcher.matches(&pattern, title, Some(detail)) {
+                    let id = row.get(0)?;
+                    collections.rows.push(CollectionRow {
+                        route: match kind {
+                            0 => Route::Album(id),
+                            1 => Route::Artist(id),
+                            _ => Route::Playlist(id),
+                        },
+                        id,
+                        title: title.to_owned(),
+                        detail: detail.to_owned(),
+                    });
+                }
+            }
+        }
+        Ok(Some(Page {
+            title,
+            rows,
+            collections,
+        }))
+    })();
+    if cancelled() {
+        None
+    } else {
+        match result {
+            Ok(None) => None,
+            Ok(Some(page)) => Some(Ok(page)),
+            Err(error) => Some(Err(error)),
+        }
+    }
+}
+use rusqlite::OptionalExtension;
+fn read_tracks(
+    database: &Database,
+    searcher: &mut Searcher,
+    input: Arc<Input>,
+    mut cancelled: impl FnMut() -> bool,
+) -> Option<Result<TrackRows, SourceError>> {
+    if input.query.len() > crate::search::MAX_QUERY_BYTES {
+        return Some(Err(SourceError::QueryTooLong));
+    }
+    if cancelled() {
+        return None;
+    }
+    let result = (|| {
+        let connection = database.connection();
+        let mut rows = TrackRows {
+            input: input.clone(),
+            rows: Vec::new(),
+            playlist_items: Vec::new(),
+        };
+        match input.route {
+            Route::Tracks | Route::Album(_) | Route::Artist(_) => {
+                let base = match input.route {
+                    Route::Album(id) => tracks().from_album(id),
+                    Route::Artist(id) => tracks().from_artist(id),
+                    _ => tracks(),
+                };
+                let query = ordered(base, &input);
+                let Some(page) =
+                    searcher.search_rows(database, &input.search, query, &mut cancelled)
+                else {
+                    return Ok(None);
+                };
+                rows.rows = page?;
+            }
+            Route::Playlist(id) => {
+                let order = match input.sort {
+                    Sort::Title => "playlist_item.position ASC, playlist_item.id ASC",
+                    Sort::Artist => {
+                        "COALESCE(album.artist_sort, track.artist_sort, track.artist_names) COLLATE NOCASE ASC, track.title_sortable ASC, playlist_item.id ASC"
+                    }
+                    Sort::Longest => {
+                        "track.duration DESC, track.title_sortable COLLATE NOCASE ASC, playlist_item.id ASC"
+                    }
+                };
+                let sql = format!(
+                    "SELECT track.id,track.title,track.artist_names,track.album_id,playlist_item.id FROM playlist_item JOIN track ON track.id=playlist_item.track_id LEFT JOIN album ON album.id=track.album_id WHERE playlist_item.playlist_id=? ORDER BY {order}"
+                );
+                let pattern =
+                    Pattern::parse(&input.query, CaseMatching::Smart, Normalization::Smart);
+                let mut statement = connection.prepare(&sql)?;
+                let mut cursor = statement.query([id])?;
+                while let Some(row) = cursor.next()? {
+                    if cancelled() {
+                        return Ok(None);
+                    }
+                    let title = row.get_ref(1)?.as_str().map_err(text_error)?;
+                    let artist = row.get_ref(2)?.as_str_or_null().map_err(text_error)?;
+                    if searcher.matches(&pattern, title, artist) {
+                        rows.rows.push(TrackSearchRow {
+                            id: row.get(0)?,
+                            title: title.to_owned(),
+                            artist_names: artist.map(str::to_owned),
+                            album_id: row.get(3)?,
+                        });
+                        rows.playlist_items.push(row.get(4)?);
+                    }
+                }
+            }
+            _ => {}
+        }
+        Ok(Some(rows))
+    })();
+    if cancelled() {
+        None
+    } else {
+        result.transpose()
+    }
+}
+fn ordered(query: TrackQuery, input: &Input) -> TrackQuery {
+    match input.sort {
+        Sort::Title if matches!(input.route, Route::Album(_)) => {
+            query.sort_asc(TrackColumn::TrackNumber)
+        }
+        Sort::Title => query.sort_asc(TrackColumn::Title),
+        Sort::Artist => query.sort_asc(TrackColumn::Artist),
+        Sort::Longest => query.sort_desc(TrackColumn::Length),
+    }
+}
+/// Materialize queue metadata only after an explicit action. The page query is
+/// shared with display, so filter/order and selected occurrence cannot drift.
+pub(crate) fn prepare(
+    database: &Database,
+    searcher: &mut Searcher,
+    request: &PlayRequest,
+) -> Result<PreparedListing, SourceError> {
+    let _snapshot = database.connection().unchecked_transaction()?;
+    let rows = read_tracks(database, searcher, request.input.clone(), || false)
+        .expect("uncancelled listing")?;
+    let start = match request.start {
+        Some(key) => (0..rows.len())
+            .find(|i| rows.identity(*i) == key)
+            .ok_or(SourceError::MissingCollection)?,
+        None => 0,
+    };
+    if rows.is_empty() {
+        return Err(SourceError::NoSelection);
+    }
+    let mut prepared = Vec::with_capacity(rows.len());
+    let mut statement = database
+        .connection()
+        .prepare("SELECT location FROM track WHERE id=?")?;
+    for row in rows.rows {
+        let path: String = statement
+            .query_row([row.id], |result| result.get(0))
+            .optional()?
+            .ok_or(SourceError::MissingTrack(row.id))?;
+        let path = std::path::PathBuf::from(path);
+        prepared.push(crate::queue::TrackRef::new(crate::queue::Track {
+            available_when_prepared: path.exists(),
+            path,
+            track_id: Some(row.id),
+            album_id: row.album_id,
+            title: row.title,
+        }));
+    }
+    if !prepared[start].available_when_prepared {
+        return Err(SourceError::MissingTrack(prepared[start].track_id.unwrap()));
+    }
+    Ok(PreparedListing {
+        tracks: prepared,
+        start,
+    })
+}
+
+fn text_error(error: rusqlite::types::FromSqlError) -> SourceError {
+    rusqlite::Error::FromSqlConversionFailure(0, rusqlite::types::Type::Text, Box::new(error))
+        .into()
+}
