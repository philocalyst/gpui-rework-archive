+fn playlist<L: LaneSet<Library>>(
+    win: &mut Win<Library, L>,
+    worker: &Worker,
+) -> triomphe::Arc<hummingbird_gpui_port::browser::Input> {
+    win.update(|model| model.navigate(hummingbird_gpui_port::browser::Route::Playlist(2)))
