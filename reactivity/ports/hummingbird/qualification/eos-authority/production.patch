+    #[test]
+    fn conditional_advance_checks_token_before_edit_and_preserves_pause() {
+        use std::cell::Cell;
+        let called = Cell::new(false);
+        for control in ["seek", "stop", "closed", "exhausted"] {
+            let (handle, _) = active_handle(if control == "exhausted" { u64::MAX } else { 1 });
+            let from = handle.receipt().unwrap().token.unwrap();
+            match control {
+                "seek" => {
+                    handle.seek(0).unwrap();
+                }
+                "stop" => {
+                    handle.stop().unwrap();
+                }
+                "closed" => handle.shared.gate.0.closed.store(true, Ordering::Release),
+                _ => {}
+            }
+            let result = handle.advance_if(from, || {
+                called.set(true);
+                Ok(None)
+            });
+            match control {
+                "closed" => assert_eq!(result.unwrap_err(), AudioError::Closed),
+                "exhausted" => assert_eq!(result.unwrap_err(), AudioError::Exhausted),
+                _ => assert!(result.unwrap().is_none()),
+            }
+            assert!(!called.get());
+        }
+        let (handle, _) = active_handle(1);
+        let from = handle.receipt().unwrap().token.unwrap();
+        let paused = handle.set_playing(false).unwrap();
+        assert_eq!(paused.token, Some(from));
+        assert_eq!(
+            handle
+                .advance_if(from, || Err(crate::queue::QueueError::PlanExhausted))
+                .unwrap_err(),
+            AudioError::Queue(crate::queue::QueueError::PlanExhausted)
+        );
+        assert_eq!(handle.receipt().unwrap().revision, paused.revision);
+        let (committed, playing) = handle.advance_if(from, || Ok(None)).unwrap().unwrap();
+        assert_eq!(committed.revision, paused.revision + 1);
+        assert_eq!(committed.token, Some(from));
+        assert!(!playing);
+        assert!(!handle.shared.gate.allows(1));
+        assert!(handle.shared.desired.lock().unwrap().plan.is_none());
+    }
