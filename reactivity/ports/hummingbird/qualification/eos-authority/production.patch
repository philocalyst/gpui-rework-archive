+impl Intent {
+    fn apply(&mut self, plan: Option<Plan>, transition: Transition) -> Result<(), AudioError> {
+        if matches!(transition, Transition::Advance { from } if self.token != Some(from)) {
+            return Err(AudioError::Unsupported("stale source-end transition"));
+        }
+        let equal = plan.as_ref().map(Plan::stamp) == self.plan.as_ref().map(Plan::stamp);
+        if !equal || plan.is_none() {
+            self.seek = None;
+            self.transition = transition;
+            match (&plan, transition) {
+                (Some(plan), _) => {
+                    self.token = Some(Token {
+                        stamp: plan.stamp(),
+                        revision: self.revision,
+                    });
+                    if transition == Transition::Replace {
+                        self.playing = true;
+                        self.output_epoch = self.revision;
+                    }
+                }
+                (None, Transition::Advance { from }) => self.token = Some(from),
+                (None, Transition::Replace) => {
+                    self.token = None;
+                    self.playing = false;
+                    self.output_epoch = 0;
+                }
+            }
+        }
+        self.plan = plan;
+        Ok(())
+    }
+}
