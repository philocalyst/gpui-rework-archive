+fn fft_geometry(source: u32, target: u32) -> Result<(usize, usize), AudioError> {
+    let limit = || AudioError::Unsupported("FFT rate-pair resource limit");
+    if source == 0 || target == 0 {
+        return Err(limit());
+    }
+    let (mut gcd, mut divisor) = (source, target);
+    while divisor != 0 {
+        (gcd, divisor) = (divisor, gcd % divisor);
+    }
+    let chunk = (source as usize).div_ceil(50);
+    let sub_chunks = (chunk / 256).max(1);
+    let minimum_input = (source / gcd) as usize;
+    let units = (chunk / sub_chunks).div_ceil(minimum_input).max(1);
+    let input = units.checked_mul(minimum_input).ok_or_else(limit)?;
+    let output = units
+        .checked_mul((target / gcd) as usize)
+        .ok_or_else(limit)?;
+    if input > MAX_FFT_UNIT
+        || output > MAX_FFT_UNIT
+        || input * 10 > source as usize
+        || output * 10 > target as usize
+        || !smooth_fft_unit(input)
+        || !smooth_fft_unit(output)
+    {
+        return Err(limit());
+    }
+    Ok((input, output))
+}
